/* Writer Tools — all-static conlang/language-history workbench orchestration. */
(function(global){'use strict';const clone=v=>v==null?v:JSON.parse(JSON.stringify(v));
function parseInstruction(text=''){const s=String(text),years=Number((s.match(/(?:fast[- ]?forward|over|after)\s+(\d[\d,]*)\s+years?/i)||s.match(/(\d[\d,]*)\s*[- ]?year/i)||[])[1]?.replace(/,/g,''))||1500;const wants={ttf:/\bttf\b|truetype|font/i.test(s),pdf:/\bpdf\b|guide|document/i.test(s),txt:/\btxt\b|text file|rules/i.test(s),csv:/table|csv|letter evolution/i.test(s)};return {years,wants,mentionsHieroglyphs:/hieroglyph|pictograph|ancestral sign/i.test(s),raw:s};}
function normalizeSymbols(symbols=[],opts={}){return (symbols||[]).map((s,i)=>({id:s.id||`sign-${i+1}`,meaning:s.meaning||s.gloss||`concept ${i+1}`,spokenWord:s.spokenWord||s.word||s.name||`word${i+1}`,sound:s.sound||s.phoneme||'',name:s.name||s.spokenWord||s.word||`letter-${i+1}`,glyph:s.glyph||s.character||'',svgPath:s.svgPath||null,contours:clone(s.contours||null),bitmap:clone(s.bitmap||null),codePoint:s.codePoint??null,medium:s.medium||opts.medium||'stone',notes:s.notes||''}));}
function prepare(input={}){const instruction=parseInstruction(input.instruction||input.prompt||''),years=Number(input.years||input.fastForwardYears||instruction.years||1500),name=input.name||input.languageName||'Unnamed Language',ancestor=clone(input.ancestor||input.protoLanguage||{}),symbols=normalizeSymbols(ancestor.script?.symbols||input.symbols||input.hieroglyphs||[],{medium:input.medium||ancestor.script?.medium});const phonemes=ancestor.phonemes||input.phonemes||global.WriterToolsPhonology?.suggestInventory?.({size:input.inventorySize||24,seed:input.seed||name})?.map(x=>x.symbol);const grammar={...(global.WriterToolsGrammarTypology?.generate?.({name,seed:`${input.seed||name}:grammar`,grammar:ancestor.grammar||input.grammar,complexity:input.grammarComplexity})||{}),...(ancestor.grammar||input.grammar||{})};const lexicon=ancestor.lexicon?.length?ancestor.lexicon:global.WriterToolsLexiconEvolution?.generateCore?.({seed:`${input.seed||name}:lex`,phonemes,phonotactics:ancestor.phonotactics||input.phonotactics});let preparedSymbols=symbols;if(symbols.length&&global.WriterToolsGlyphSynthesis)preparedSymbols=global.WriterToolsGlyphSynthesis.synthesizeAlphabet(symbols,{seed:`${input.seed||name}:glyph`,medium:input.medium||'stone',style:input.glyphStyle||{}});return {...clone(input),name,years,seed:input.seed||name,ancestor:{...ancestor,phonemes,grammar,lexicon,script:{...(ancestor.script||input.script||{}),type:ancestor.script?.type||input.script?.type||'pictographic/logographic',direction:ancestor.script?.direction||input.script?.direction||'right-to-left',symbols:preparedSymbols}},events:clone(input.historicalEvents||input.events||[]),_instruction:instruction};}
function enrich(result={},prepared={}){const out=clone(result),years=out.years||prepared.years,events=prepared.events||[];const g=global.WriterToolsGrammarTypology?.evolve?.(prepared.ancestor.grammar,{seed:`${prepared.seed}:grammar-history`,years,stageYears:prepared.stageYears||150,contact:events.filter(x=>x.contactLanguage).length/Math.max(1,events.length),standardization:events.some(x=>x.scriptPolicy==='standardize')?.8:.2});if(g){out.grammarEvolution=g;if(out.modern)out.modern.grammar={...out.modern.grammar,...g.modern};}const socio=global.WriterToolsSociolinguistics?.languageShiftScenario?.({years,events,vitality:prepared.vitality||{}});if(socio){out.sociolinguistics=socio;out.dialectTree=global.WriterToolsSociolinguistics.dialectTree({name:prepared.name,rootName:`Proto-${prepared.name}`,years,seed:`${prepared.seed}:dialects`,regions:prepared.regions});let dt=out.dialectTree;for(const st of out.stages||[]){for(const ch of st.changes||[]){if(ch.domain==='phonology'&&ch.rule)dt=global.WriterToolsSociolinguistics.diffuseInnovation(dt,{id:`sound-${st.year}-${ch.id||ch.rule}`,name:ch.rule,year:st.year},{seed:`${prepared.seed}:diff:${st.year}:${ch.rule}`,rate:.45});}}out.dialectTree=dt;}if(out.modern?.lexicon&&global.WriterToolsLexiconEvolution){const contact=[];for(const e of events)if(e.contactLanguage)contact.push(...global.WriterToolsLexiconEvolution.contactWave(out.modern,e,{seed:`${prepared.seed}:contact:${e.year}`}));out.modern.lexicon.push(...contact);out.lexicalHistory={contactLoans:contact,slang:global.WriterToolsLexiconEvolution.slang(out.modern.lexicon,{seed:`${prepared.seed}:slang`,year:years,count:Math.min(24,Math.max(4,Math.round(years/200)))})};out.modern.lexicon.push(...out.lexicalHistory.slang);}if(out.scriptEvolution&&global.WriterToolsGlyphSynthesis){out.scriptEvolution=global.WriterToolsGlyphSynthesis.attachToScript(out.scriptEvolution,{seed:`${prepared.seed}:script-final`,medium:prepared.finalMedium||prepared.medium||'screen',style:prepared.finalGlyphStyle||{}});if(out.scriptEvolution.modern?.symbols&&global.WriterToolsLexiconEvolution)out.scriptEvolution.modern.symbols=global.WriterToolsLexiconEvolution.letterExamples(out.scriptEvolution.modern.symbols,out.modern?.lexicon||[]);if(global.WriterToolsScriptEvolution?.buildEvolutionTable)out.scriptEvolution.letterEvolutionTable=global.WriterToolsScriptEvolution.buildEvolutionTable(out.scriptEvolution.modern?.symbols||[],out.scriptEvolution.modern?.retiredSymbols||[]);}out.schema='writer.conlang-workbench.v2';return out;}
function create(input={}){if(!global.WriterToolsLanguageEvolution)throw new Error('helper-world-model.js is required');const prepared=prepare(input),base=global.WriterToolsLanguageEvolution.simulate(prepared);return enrich(base,prepared);}
async function artifacts(input={},opts={}){const result=input?.schema==='writer.conlang-workbench.v2'?input:create(input);if(!global.WriterToolsLanguageExport)throw new Error('helper-creative.js is required');return global.WriterToolsLanguageExport.buildArtifacts(result,opts);}
async function generateProject(input={},opts={}){const result=create(input),files=await artifacts(result,opts);return {result,files,summary:{name:result.name,years:result.years,phonemes:result.modern?.phonemes?.length||0,words:result.modern?.lexicon?.length||0,letters:result.scriptEvolution?.modern?.symbols?.length||0,retiredLetters:result.scriptEvolution?.modern?.retiredSymbols?.length||0,grammar:result.modern?.grammar||{},vitality:result.sociolinguistics?.history?.at(-1)?.status||result.modern?.vitality?.status||null}};}
function validate(result={}){const issues=[];const g=global.WriterToolsGrammarTypology?.validate?.(result.modern?.grammar||{});if(g)issues.push(...g.issues);if(!result.modern?.phonemes?.length)issues.push({severity:'error',code:'no-phonemes',message:'No modern phoneme inventory.'});if(result.scriptEvolution&&!result.scriptEvolution.modern?.symbols?.length)issues.push({severity:'warning',code:'no-modern-letters',message:'Script exists but has no active modern symbols.'});for(const s of result.scriptEvolution?.modern?.symbols||[])if(!s.contours?.length&&!s.svgPath&&!s.bitmap&&!s.glyph)issues.push({severity:'warning',code:'glyph-outline-missing',symbol:s.id,message:`${s.id} has no drawable source.`});return {ok:!issues.some(x=>x.severity==='error'),issues};}
async function researchPacket(query={},n=4){const calls=[global.WriterToolsGrammarTypology?.sampleAtlas?.(query,n),global.WriterToolsLexiconEvolution?.sampleAtlas?.(query,n),global.WriterToolsSociolinguistics?.sampleAtlas?.(query,n),global.WriterToolsGlyphSynthesis?.sampleAtlas?.(query,n)].filter(Boolean);return (await Promise.all(calls)).flat();}
global.WriterToolsConlangWorkbench=Object.freeze({parseInstruction,normalizeSymbols,prepare,enrich,create,artifacts,generateProject,validate,researchPacket});
})(typeof globalThis!=='undefined'?globalThis:window);

