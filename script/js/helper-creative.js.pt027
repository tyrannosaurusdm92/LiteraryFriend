"];const cache=new Map();async function loadAtlasShard(i=0){i=Math.max(0,Math.min(PACKS.length-1,Number(i)||0));if(cache.has(i))return cache.get(i);const data=JSON.parse(await ungzip64(PACKS[i]));cache.set(i,data);return data;}async function sampleAtlas(query={},n=8){const i=hash(JSON.stringify(query))%PACKS.length,rows=await loadAtlasShard(i),terms=Object.values(query).flatMap(v=>Array.isArray(v)?v:[v]).filter(Boolean).map(x=>String(x).toLowerCase());let out=terms.length?rows.filter(row=>terms.some(t=>JSON.stringify(row).toLowerCase().includes(t))):rows;const r=rng(JSON.stringify(query));if(out.length>n)out=[...out].sort(()=>r()-.5).slice(0,n);return clone(out.slice(0,n));}
