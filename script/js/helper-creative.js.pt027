function sceneModel(input={}){const beats=input.beats||[],goal=input.goal||input.objective||null,conflict=input.conflict||null,stakes=input.stakes||null,turn=input.turn||input.reversal||null,outcome=input.outcome||null,aftermath=input.aftermath||null;const missing=[['goal',goal],['conflict',conflict],['stakes',stakes],['turn/outcome',turn||outcome]].filter(x=>!x[1]).map(x=>x[0]);return{goal,conflict,stakes,turn,outcome,aftermath,beats,missing,causalQuestion:'Because of what happens here, what becomes harder, easier, newly possible, newly impossible, known, owed, broken, promised, or dangerous?',releaseRule:'Release tension by changing state, information, relationship, safety, resources, or choice-space—not merely by lowering volume.'};}
function tensionCurve(beats=[]){let pressure=.2;return(beats||[]).map((b,i)=>{const delta=Number(b.delta??({setup:.04,obstacle:.12,reveal:.1,reversal:.18,loss:.2,deadline:.14,choice:.12,relief:-.18,payoff:-.22,aftermath:-.12}[b.type]??.06));pressure=clamp(pressure+delta);return{beat:i+1,type:b.type||'beat',pressure:Number(pressure.toFixed(3)),cause:b.cause||b.text||'',effect:b.effect||''};});}
function dialogueAudit(text,characters={}){const lines=String(text||'').split(/\r?\n/).filter(Boolean),turns=[];for(const line of lines){let m=line.match(/^\s*([^:“"]{1,48})\s*:\s*[“\"]?(.+?)[”\"]?\s*$/);if(m)turns.push({speaker:m[1].trim(),text:m[2].trim()});}const per={};for(const t of turns){const a=per[t.speaker]||(per[t.speaker]={turns:0,words:0,questions:0,exposition:0,contractions:0,signature:new Map});a.turns++;a.words+=words(t.text).length;a.questions+=(t.text.match(/\?/g)||[]).length;a.exposition+=(t.text.match(/\b(?:as you know|as we both know|remember when I told you|the reason is that)\b/gi)||[]).length;a.contractions+=(t.text.match(/\b\w+[’']\w+\b/g)||[]).length;for(const w of words(t.text).map(x=>x.toLowerCase()).filter(x=>x.length>4&&!STOP.has(x)))a.signature.set(w,(a.signature.get(w)||0)+1);}for(const [name,a] of Object.entries(per)){a.meanWords=Number((a.words/Math.max(1,a.turns)).toFixed(1));a.signature=[...a.signature].sort((x,y)=>y[1]-x[1]).slice(0,8).map(x=>x[0]);a.characterConstraint=characters[name]||null;}const names=Object.keys(per),similar=[];for(let i=0;i<names.length;i++)for(let j=i+1;j<names.length;j++){const A=new Set(per[names[i]].signature),B=new Set(per[names[j]].signature);let n=0;for(const x of A)if(B.has(x))n++;const score=n/Math.max(1,Math.min(A.size,B.size));if(score>=.6)similar.push({speakers:[names[i],names[j]],score:Number(score.toFixed(2)),note:'Check whether these speakers are converging into the same vocabulary/rhythm without story reason.'});}return{turns:turns.length,speakers:per,similarVoices:similar,expositionFlags:Object.values(per).reduce((n,x)=>n+x.exposition,0)};}
function plotLedger(items=[]){const setups=new Map,open=[],issues=[];for(const raw of items||[]){const x=raw||{},id=x.id||x.key||x.name||`item-${open.length+1}`;if(['setup','promise','question','mystery','foreshadow'].includes(x.type)){setups.set(id,x);open.push(id);}if(['payoff','answer','resolution'].includes(x.type)){const target=x.target||x.setupId||x.promiseId;if(target&&setups.has(target)){const k=open.indexOf(target);if(k>=0)open.splice(k,1);}else issues.push({code:'PAYOFF_WITHOUT_SETUP',item:x});}if(x.requires&&!items.some(y=>(y.id||y.key)===x.requires))issues.push({code:'MISSING_PREREQUISITE',item:x});}return{open:open.map(id=>setups.get(id)),issues};}
function cliffhanger(input={}){return{question:input.question||'What concrete consequence or answer is deferred?',kind:input.kind||'consequence/revelation/choice',openedBy:input.openedBy||'the causal turn at scene end',payoffWithin:Number(input.payoffWithin||3),rules:['The hook must arise from the current scene’s cause-and-effect.','Track the exact question/promise opened.','Pay it, transform it, or deliberately defer it with new information; do not forget it.','Do not substitute arbitrary danger for an earned unresolved consequence.']};}
function trope(tropeName,input={}){return{trope:tropeName||'genre pattern',readerPromise:input.readerPromise||'orientation/familiar expectation',specificity:['cause','motive','culture/setting','power relationship','cost','consequence','POV knowledge','timing'],subversionRule:'Change a trope only when the replacement creates stronger causality, character truth, theme, or surprise. Random inversion is not automatically fresher.',audit:['Is this pattern doing useful compression?','Which causal details make it belong uniquely to this story?','What assumptions does the story keep, question, or reverse?','Does payoff honor the emotional promise even if events subvert the surface pattern?']};}
function poemAudit(text,form='free verse'){const lines=String(text||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean),counts=lines.map(x=>words(x).reduce((n,w)=>n+syllables(w),0));const out={form,lines:lines.length,syllables:counts,mean:Number((counts.reduce((a,b)=>a+b,0)/Math.max(1,counts.length)).toFixed(2)),warnings:[]};if(/haiku/i.test(form)&&lines.length!==3)out.warnings.push('English-language haiku is not universally defined by 5-7-5, but a requested 3-line form should still be respected.');if(/haiku/i.test(form)&&lines.length===3)out.fiveSevenFive=counts[0]===5&&counts[1]===7&&counts[2]===5;return out;}
function lyricAudit(text){const lines=String(text||'').split(/\r?\n/),sections=[];let current={name:'unlabeled',lines:[]};sections.push(current);for(const line of lines){const h=line.match(/^\s*\[?((?:verse|pre-?chorus|chorus|bridge|breakdown|outro|intro|refrain|post-?chorus)[^\]]*)\]?\s*:?[ ]*$/i);if(h){current={name:h[1],lines:[]};sections.push(current);}else if(line.trim())current.lines.push(line.trim());}return{sections:sections.filter(x=>x.lines.length).map(s=>({name:s.name,lines:s.lines.length,syllables:s.lines.map(x=>words(x).reduce((n,w)=>n+syllables(w),0)),meanWords:Number((s.lines.reduce((n,x)=>n+words(x).length,0)/Math.max(1,s.lines.length)).toFixed(2))})),voice:global.HelperPersona?.lyricDiagnostics?.(text)||null,rules:['chorus/hook should usually be cognitively simpler than verse','protect spoken stress before rhyme','avoid adding a second metaphor when the first already carries the section','repeat title/anchor where repetition changes emotional pressure','leave melodic breathing room instead of writing prose-length lyric lines']};}
function proseAudit(text,options={}){const voice=global.HelperPersona?.audit?.(text,options)||null;return{sentences:sentenceStats(text),lexical:lexicalDiversity(text),voice,issues:[...(voice?.issues||[])]};}
function craftPacket(input={}){const kind=global.WriterWilliamVoice?.taskKind?.(input)||input.kind||'story',packet={kind,voicePrompt:global.HelperPersona?.prompt?.({...input,kind})||'',prose:input.text?proseAudit(input.text,{...input,kind}):null};if(kind==='lyrics'&&input.text)packet.lyrics=lyricAudit(input.text);if(kind==='poetry'&&input.text)packet.poem=poemAudit(input.text,input.form||'free verse');if((kind==='story'||kind==='dialogue')&&input.text)packet.dialogue=dialogueAudit(input.text,input.characters||{});if(input.scene)packet.scene=sceneModel(input.scene);if(input.beats)packet.tension=tensionCurve(input.beats);if(input.trope)packet.trope=trope(input.trope,input);if(input.cliffhanger)packet.cliffhanger=cliffhanger(input.cliffhanger);return packet;}
function improve(text,options={}){const governed=global.HelperPersona?.govern?.(text,options)||{content:String(text||''),audit:null};return{...governed,craft:craftPacket({...options,text:governed.content})};}
const baseFallback=global.WriterFallbackBrain;if(baseFallback){function generate(request={},context={}){const r=baseFallback.generate(request,context),k=r.kind||global.WriterWilliamVoice?.taskKind?.(request)||'story',g=improve(r.content,{...request,kind:k,context});return{...r,content:g.content,audit:g.audit,deepCraft:g.craft,engine:`${r.engine||'writer-fallback'}+deep-craft-v4`};}global.WriterFallbackBrain=Object.freeze({...baseFallback,generate});}
global.HelperCreativeResearch=Object.freeze({VERSION:'4.0.0-ready',syllables,sentenceStats,lexicalDiversity,sceneModel,tensionCurve,dialogueAudit,plotLedger,cliffhanger,trope,poemAudit,lyricAudit,proseAudit,craftPacket,improve});
})(typeof globalThis!=='undefined'?globalThis:window);

