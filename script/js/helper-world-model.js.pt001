(function(global){'use strict';
const base=global.WriterToolsScriptEvolution;if(!base)return;const oldNarrative=base.evolutionNarrative;
function evolutionNarrative(result={}){return (oldNarrative?.(result)||[]).map((row,i)=>{const changes=(row.changes||[]).map(c=>typeof c==='string'?c:(c.description||c.type||c.kind||JSON.stringify(c))).filter(Boolean);const from=Array.isArray(row.scriptType)?row.scriptType[0]:row.scriptType,to=Array.isArray(row.scriptType)?row.scriptType[1]:row.scriptType;const packet=global.WriterWilliamVoice?.buildPacket?.({kind:'language_history',form:'script-history',prompt:`${row.fromYear} to ${row.toYear}: ${changes.join('; ')}`})||null;let description=`From roughly year ${row.fromYear} to ${row.toYear}, the writing system${from&&to&&from!==to?` shifts from ${from} toward ${to}`:' changes through use and reform'}. ${changes.length?`The recorded pressures include ${changes.slice(0,4).join('; ')}.`:''} By this stage, ${row.activeLetters||0} active signs remain in regular use${row.retiredLetters?`, while ${row.retiredLetters} older signs are retired or specialized`:''}.`;description=global.WriterWilliamVoice?.repairHeuristic?.(description,{kind:'language_history'})||description;return{...row,description,voice:'William Saville / clear historical exposition',william_voice:packet,sequence:i+1};});}
function narrativeText(result={}){const rows=evolutionNarrative(result);return rows.map(x=>x.description).join('\n\n');}
