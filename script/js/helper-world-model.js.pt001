 // Explicit reforms can retire letters by id, glyph, name, or sound.
 const dropKeys=new Set(active.flatMap(e=>e.dropLetters||[]).map(x=>String(typeof x==='object'?(x.id||x.sound||x.glyph||x.name):x)));if(dropKeys.size){const keep=[];for(const s of symbols){if([s.id,s.sound,s.glyph,s.name].some(v=>dropKeys.has(String(v)))){const old={...s,status:'retired',retiredYear:y,history:[...(s.history||[]),{year:y,status:'retired',sound:s.sound,name:s.name,reason:'orthographic reform retired sign'}]};retired.push(old);changes.push(`${s.id}: retired from active alphabet`);}else keep.push(s);}symbols=keep;}
 // Explicit additions and borrowings are accepted from the historical-event input.
 const additions=eventLetterAdditions(active,lang,symbols,y).filter(a=>!symbols.some(s=>s.sound===a.sound&&s.name===a.name));for(const a of additions){a.status='active';a.history=[{year:y,status:'active',sound:a.sound,name:a.name,reason:'new/borrowed orthographic sign'}];symbols.push(a);changes.push(`${a.id}: added for /${a.sound}/`);}
 // Once the system is substantially phonographic, gaps created by phoneme splits or contact can acquire new signs.
 if(lang?.phonemes?.length&&/phonographic|alphabet|abugida|abjad/i.test(scriptType)){const represented=new Set(symbols.map(s=>s.sound).filter(Boolean)),missing=lang.phonemes.filter(ph=>!represented.has(ph));const capacity=Math.min(2,missing.length);for(let i=0;i<capacity;i++){const sound=missing[i],parent=symbols.length?symbols[Math.floor(r()*symbols.length)]:null,name=letterWordForSound(lang,sound);const a=normalizeSymbol({id:`innovation-${y}-${String(sound).codePointAt(0)?.toString(16)||i}`,contours:deriveNewContours(parent,`${input.seed}:${y}:${sound}`),meaning:`phonographic sign for /${sound}/`,spokenWord:name,sound,name,notes:'created after a phonemic gap/split/contact pressure'},symbols.length);a.status='active';a.history=[{year:y,status:'active',sound,name,reason:'new sign differentiated to represent an unrepresented sound'}];symbols.push(a);changes.push(`${a.id}: differentiated/new sign for /${sound}/`);}}
 if(scriptType.includes('pict')&&y>=years*.2){scriptType='mixed logographic + acrophonic';changes.push('some pictorial signs became reusable acrophonic phonograms');}if(/logographic/.test(scriptType)&&y>=years*.45){scriptType='mixed phonographic';changes.push('phonographic signs expanded beyond their original lexical meanings');}if(scriptType==='mixed phonographic'&&y>=years*.65){scriptType='alphabetic/phonographic with inherited logograms';changes.push('phonographic inventory became productive enough to write unfamiliar words while some inherited signs remained');}stages.push({year:y,scriptType,direction,symbols:clone(symbols),retiredSymbols:clone(retired),changes});if(y===years)break;}
