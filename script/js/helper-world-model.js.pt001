function evolutionNarrative(result={}){const stages=result.stages||[],out=[];for(let i=1;i<stages.length;i++){const a=stages[i-1],b=stages[i];out.push({fromYear:a.year,toYear:b.year,scriptType:[a.scriptType,b.scriptType],direction:[a.direction,b.direction],changes:clone(b.changes||[]),activeLetters:b.symbols?.length||0,retiredLetters:b.retiredSymbols?.length||0});}return out;}
