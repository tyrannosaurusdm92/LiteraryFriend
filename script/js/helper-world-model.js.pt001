function buildEvolutionTable(symbols=[],retired=[]){return [...symbols,...retired].map(s=>({id:s.id,status:s.status||'active',retiredYear:s.retiredYear??null,ancestralMeaning:s.meaning,ancestralWord:s.spokenWord,acrophonicBase:acrophonicValue(s),modernSound:s.sound,modernLetterName:s.name,codePoint:s.status==='retired'?'':(s.codePoint?`U+${s.codePoint.toString(16).toUpperCase().padStart(4,'0')}`:''),notes:s.notes||'',stages:(s.history||[]).map(h=>({year:h.year,status:h.status||'active',sound:h.sound,name:h.name,reason:h.reason}))}));}
function lineageForLatin(letter){return clone(LATIN_LINEAGE.find(x=>x.letter===String(letter||'').toUpperCase())||null);}
