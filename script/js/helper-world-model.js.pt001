/* Writer Tools — project character library. Supports local project profiles and optional external JSON indexes. */
(function(global){'use strict';
 const state={profiles:new Map(),index:null};const clone=v=>v==null?v:JSON.parse(JSON.stringify(v));const norm=s=>String(s||'').toLowerCase().replace(/[’]/g,"'").replace(/[^a-z0-9' -]+/g,' ').replace(/\s+/g,' ').trim();
 function register(profile={}){const id=String(profile.id||profile.name||`character-${state.profiles.size+1}`);const row={id,name:profile.name||id,aliases:profile.aliases||[],role:profile.role||'',identity:profile.identity||{},appearance:profile.appearance||{},personality:profile.personality||{},voice:profile.voice||{},goals:profile.goals||[],fears:profile.fears||[],relationships:profile.relationships||[],knowledge:profile.knowledge||[],continuity:profile.continuity||{},source:profile.source||'project',...clone(profile)};state.profiles.set(id,row);return clone(row);}
 function registerMany(rows=[]){return rows.map(register);}
 function all(){return [...state.profiles.values()].map(clone);}
 function search({query='',limit=24}={}){const q=norm(query);return all().map(p=>{const hay=norm([p.name,...(p.aliases||[]),p.role,JSON.stringify(p.personality||{}),JSON.stringify(p.voice||{})].join(' '));let score=!q?1:(hay.includes(q)?100:q.split(' ').filter(Boolean).reduce((n,w)=>n+(hay.includes(w)?10:0),0));return {score,profile:p};}).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,limit);}
 async function loadIndex(path='json/characters/index.json'){try{const r=await fetch(path,{cache:'no-cache'});if(!r.ok)return null;state.index=await r.json();return clone(state.index);}catch(_e){return null;}}
 async function loadSupportMaterials(){return {rules:{rules:['Keep characters distinct.','Track what each character knows.','Do not merge same-name characters automatically.']},continuation:{},researchManifest:null};}
 async function materialCatalog(){return {profile_count:state.profiles.size,source:'writer-tools-character-library'};}
 function contextPacketSync({characterIds=[],query='',characters=[]}={}){for(const c of characters||[])if(c&&typeof c==='object')register(c);const ids=new Set(characterIds||[]);if(query)for(const row of search({query,limit:12}))ids.add(row.profile.id);return {schema:'writer.character-context.v1',profiles:[...ids].map(id=>state.profiles.get(id)).filter(Boolean).map(clone)};}
 async function ensureForContext(opts={}){return contextPacketSync(opts);}
 function promptForPacket(packet={}){return (packet.profiles||[]).map(p=>`CHARACTER ${p.name}: role=${p.role||'unspecified'}; personality=${JSON.stringify(p.personality||{})}; voice=${JSON.stringify(p.voice||{})}; goals=${JSON.stringify(p.goals||[])}; continuity=${JSON.stringify(p.continuity||{})}`).join('\n');}
 global.WriterToolsCharacterLibrary=Object.freeze({register,registerMany,all,search,loadIndex,loadSupportMaterials,materialCatalog,contextPacketSync,ensureForContext,promptForPacket});
})(typeof globalThis!=='undefined'?globalThis:window);


