/* ===== RESEARCH EXPANSION PASS II — script/orthography pathways ===== */
(function(global){'use strict';
const base=global.WriterToolsScriptEvolution;if(!base)return;const clone=v=>v==null?v:JSON.parse(JSON.stringify(v));
const SCRIPT_PATHWAYS=Object.freeze({pictographic:['semantic sign use','rebus/phonetic use','mixed logographic-phonographic','optional determinatives/classifiers'],logographic:['phonetic complements','syllabic rebus values','mixed logographic-phonographic'],syllabary:['sign mergers/splits','diacritics','supplemental consonant/vowel marks'],abjad:['matres lectionis','optional vowel marks','full vowel letters in some adaptations'],abugida:['inherent-vowel restructuring','vowel-sign reanalysis','consonant-cluster conventions'],alphabet:['digraphs','diacritics','new letters','letter mergers/splits','orthographic depth'],mixed:['parallel sign classes','specialized logograms','phonographic fallback']});
function classifyScript(type=''){const t=String(type).toLowerCase();for(const k of Object.keys(SCRIPT_PATHWAYS))if(t.includes(k))return k;return 'mixed';}
function historicalPathways(type='mixed'){return clone(SCRIPT_PATHWAYS[classifyScript(type)]||SCRIPT_PATHWAYS.mixed);}
function explainLatinLineage(letter){const row=base.lineageForLatin?.(letter);return row?{...row,caveat:'This is a simplified historical lineage. Individual sign shapes and values vary across time, region, inscriptional tradition, and scholarly reconstruction.'}:null;}
function orthographyDesign(language={},opts={}){const phonemes=language.phonemes||language.modern?.phonemes||[],scriptType=opts.scriptType||language.scriptType||language.script?.type||'alphabet',strategy=opts.strategy||'balanced',rules=[];if(strategy==='phonemic')rules.push('Prefer one stable grapheme per contrast where practical; adapt loans to native spelling.');if(strategy==='morphophonemic')rules.push('Preserve recurring morpheme spellings even when surface pronunciation alternates.');if(strategy==='deep')rules.push('Allow historical/etymological spellings and lexical exceptions; record reading rules explicitly.');if(strategy==='balanced')rules.push('Use mostly predictable sound-spelling relations while preserving selected morphological and historical spellings.');rules.push('Do not assume every phoneme requires one letter; digraphs, diacritics, contextual values, and zero-marking are valid.');rules.push('Do not assume every historical letter must remain phonemic; conservative spelling can preserve obsolete distinctions.');return {scriptType,strategy,phonemes:clone(phonemes),rules,pathways:historicalPathways(scriptType)};}
