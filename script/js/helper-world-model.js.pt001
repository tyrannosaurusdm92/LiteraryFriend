/* Writer Tools — CYOA chapter/choice graph. */
(function(global){'use strict';
class WriterToolsStoryGraph{
  constructor(seed={}){this.nodes=new Map();this.edges=[];this.timeline=[];this.load(seed);}
  upsert(id,type='chapter',data={}){const prev=this.nodes.get(id)||{id,type};const node={...prev,...data,id,type:type||prev.type};this.nodes.set(id,node);return node;}
  relate(from,to,relation='choice-transition',data={}){const edge={from,to,relation,...data};this.edges.push(edge);return edge;}
  event(event){const e={id:event.id||global.crypto?.randomUUID?.()||`${Date.now()}-${Math.random()}`,at:event.at||new Date().toISOString(),...event};this.timeline.push(e);return e;}
  ingestChapter(chapter,{seriesKey='',choiceFrom=null}={}){if(!chapter)return null;const id=chapter.id||`${seriesKey||chapter.series_slug||'story'}-${String(chapter.chapter_number||1).padStart(2,'0')}`;const node=this.upsert(id,'writing-chapter',{seriesKey:seriesKey||chapter.series_slug||'',chapterNumber:chapter.chapter_number||null,title:chapter.title||'',generated:Boolean(chapter.generated),choices:(chapter.choices||[]).map(c=>({id:c.id,label:c.label,target:c.target,pathKey:c.path_key,effect:c.effect||{}}))});if(choiceFrom?.chapterId)this.relate(choiceFrom.chapterId,id,'choice-transition',{choiceId:choiceFrom.choiceId||null,pathKey:choiceFrom.pathKey||null});this.event({type:'chapter-visited',chapterId:id,seriesKey:node.seriesKey});return node;}
  branchTrail(fromId){const trail=[];let current=fromId,guard=0;while(current&&guard++<500){trail.push(current);const edge=[...this.edges].reverse().find(e=>e.relation==='choice-transition'&&e.to===current);current=edge?.from||null;}return trail.reverse();}
  snapshot(){return {nodes:[...this.nodes.values()],edges:[...this.edges],timeline:[...this.timeline]};}
  load(seed={}){for(const n of seed?.nodes||[])this.nodes.set(n.id,{...n});if(Array.isArray(seed?.edges))this.edges=[...seed.edges];if(Array.isArray(seed?.timeline))this.timeline=[...seed.timeline];return this;}
}
global.WriterToolsStoryGraph=WriterToolsStoryGraph;
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== Story graph analysis: causality, tension, cliffhangers, dead ends ===== */
(function(global){'use strict';
const C=global.WriterToolsStoryGraph;if(!C)return;
C.prototype.causalPath=function(from,to){const queue=[[from]],seen=new Set([from]);while(queue.length){const path=queue.shift(),last=path.at(-1);if(last===to)return path;for(const e of this.edges.filter(e=>e.from===last)){if(!seen.has(e.to)){seen.add(e.to);queue.push([...path,e.to]);}}}return null;};
C.prototype.deadEnds=function(){const outgoing=new Set(this.edges.map(e=>e.from));return [...this.nodes.values()].filter(n=>!outgoing.has(n.id)&&!['ending','resolution'].includes(n.type));};
C.prototype.unresolvedThreads=function(){const opened=new Map(),closed=new Set();for(const e of this.timeline){for(const t of e.opens||e.setups||[]){const id=typeof t==='string'?t:t.id||t.key;if(id)opened.set(id,t);}for(const t of e.closes||e.payoffs||[]){const id=typeof t==='string'?t:t.id||t.setupId||t.key;if(id)closed.add(id);}}return [...opened].filter(([k])=>!closed.has(k)).map(([id,value])=>({id,value}));};
C.prototype.tensionCurve=function(){return [...this.timeline].map((e,i)=>({index:i,id:e.id,at:e.at,tension:Number(e.tension??e.pressure??0),type:e.type}));};
C.prototype.cliffhangerLedger=function(){const open=new Map(),paid=[];for(const e of this.timeline){for(const q of e.cliffhangers||e.questionsOpened||[]){const id=typeof q==='string'?q:q.id||q.key;if(id)open.set(id,{id,openedAt:e.id||e.at,detail:q});}for(const q of e.questionsAnswered||e.cliffhangersPaid||[]){const id=typeof q==='string'?q:q.id||q.key;if(id&&open.has(id)){paid.push({...open.get(id),paidAt:e.id||e.at});open.delete(id);}}}return {open:[...open.values()],paid};};
C.prototype.branchBalance=function(){const by={};for(const e of this.edges)(by[e.from]??=[]).push(e);const rows=Object.entries(by).map(([node,edges])=>({node,choices:edges.length,relations:[...new Set(edges.map(e=>e.relation))]}));return {nodes:rows,deadEnds:this.deadEnds().map(n=>n.id),maxChoices:Math.max(0,...rows.map(r=>r.choices)),minChoices:rows.length?Math.min(...rows.map(r=>r.choices)):0};};
})(typeof globalThis!=='undefined'?globalThis:window);

