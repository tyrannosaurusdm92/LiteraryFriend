(function(global){'use strict';const base=global.WriterToolsCharacterLibrary;if(!base)return;const oldPrompt=base.promptForPacket;
function promptForPacket(packet={}){const core=oldPrompt?.(packet)||'';const names=(packet.profiles||[]).map(p=>p.name).filter(Boolean).join(', ');const voice=global.WriterWilliamVoice?.promptBlock?.({kind:'dialogue',prompt:`Character scene involving ${names}`,includeEvidence:false})||'';return [voice,'CHARACTER DIFFERENTIATION: The authorial narration uses William Saville’s voice, but each character profile below overrides that baseline inside the character’s spoken wording, habits, omissions, and social behavior. Do not make emotional fluency universal. Keep knowledge limited to what each character could know.',core].filter(Boolean).join('\n\n');}
