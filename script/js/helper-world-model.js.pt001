/* ===== Generic writing continuity helpers ===== */
function validateStoryParticipants(participants=[]){
  const issues=[]; const resolved=[];
  for(const raw of arr(participants)){
    const p=typeof raw==='string'?{name:raw}:raw||{};
    const name=String(p.name||p.id||'Unnamed character');
    const age=Number.isFinite(Number(p.age))?Number(p.age):null;
    resolved.push({name,age,role:p.role||null});
  }
  return {ok:issues.length===0,issues,resolved};
}
class RelationshipContinuityLedger{
  constructor(seed={}){this.schema='writer.relationship.continuity.v1';this.stage=seed.stage||'developing';this.boundaries={...(seed.boundaries||{})};this.events=[...(seed.events||[])];}
  record(event={}){const row={id:event.id||uid('relationship'),at:event.at||now(),...clone(event)};this.events.push(row);return clone(row);}
  snapshot(){return clone({schema:this.schema,stage:this.stage,boundaries:this.boundaries,events:this.events});}
}
class CharacterContinuityLedger{
  constructor(seed={}){this.schema='writer.character.continuity.v1';this.characters=clone(seed.characters||{});this.events=[...(seed.events||[])];}
  update(id,patch={}){const key=String(id);this.characters[key]={...(this.characters[key]||{}),...clone(patch),id:key,updatedAt:now()};return clone(this.characters[key]);}
  record(event={}){const row={id:event.id||uid('character-event'),at:event.at||now(),...clone(event)};this.events.push(row);return clone(row);}
  snapshot(){return clone({schema:this.schema,characters:this.characters,events:this.events});}
}
function recommendedRelationshipStage(chapter=1){const n=Math.max(1,Number(chapter)||1);if(n<=5)return'foundation';if(n<=10)return'growing_trust';if(n<=20)return'developing_relationship';if(n<=30)return'established_relationship';return'deepened_commitment';}
function assertWriterContinuity(snapshot={}){const issues=[];if(snapshot?.rules&&Array.isArray(snapshot.rules)){const dup=snapshot.rules.map(x=>typeof x==='string'?x:x?.text).filter(Boolean);if(new Set(dup).size!==dup.length)issues.push({code:'DUPLICATE_CONTINUITY_RULE'});}return {ok:issues.length===0,issues};}
function validateWriterProfile(profile={}){const issues=[];if(profile&&typeof profile!=='object')issues.push({code:'INVALID_VIEWPOINT_PROFILE'});return {ok:issues.length===0,issues};}
GLOBAL.StoryTools=GLOBAL.StoryTools||{};
GLOBAL.StoryTools.WriterContinuity=Object.freeze({validateStoryParticipants,RelationshipContinuityLedger,CharacterContinuityLedger,recommendedRelationshipStage,assertWriterContinuity,validateWriterProfile});

