/* Writer Tools — optional original people/place generation support. */
(function(global){'use strict';const cache=new Map(),clone=v=>v==null?v:JSON.parse(JSON.stringify(v));
 function keyFor(spec={}){return String(spec.seed||spec.key||spec.series_slug||spec.title||spec.premise||'writer-world');}
 function inferModes(source='',text=''){const s=`${source} ${text}`.toLowerCase();if(/space|starship|cyber|robot|alien|future/.test(s))return['scifi'];if(/magic|dragon|kingdom|wizard|fantasy/.test(s))return['fantasy'];return['realistic'];}
 function generateWorld(spec={}){const P=global.PeoplePlaces;if(!P?.WorldGenerator)return null;const seed=keyFor(spec);if(cache.has(seed))return cache.get(seed);const world=P.WorldGenerator.generate(seed,{peopleCount:Number(spec.support_people_count||18),modes:inferModes(spec.source_context||spec.fandom,[spec.premise,spec.tone,spec.timeline||spec.canon_window].join(' '))});cache.set(seed,world);return world;}
 function compactPerson(p={}){return {id:p.id,name:p.name?.full||p.name,age:p.life?.age??p.age,pronouns:p.identity?.pronouns,personality:p.personality,interests:p.interests,work:p.life?.workEducation?.work,currentPlaceId:p.currentPlaceId};}
