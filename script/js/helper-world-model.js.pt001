/* Writer Tools — diachronic language, grammar, vocabulary, dialect, slang, contact, and vitality evolution engine.
Designed for fiction/worldbuilding but grounded in historical-linguistic mechanisms. Research provenance: docs/README.md (Language Evolution Research & Implementation Sources). */
(function(global){'use strict';
const SOUND_CHANGES=Object.freeze([{"id":"assimilation","summary":"A segment becomes more similar to a nearby segment.","examples":["place assimilation","voicing assimilation","nasal assimilation"]},{"id":"dissimilation","summary":"Nearby similar sounds become less alike.","examples":["liquid dissimilation","feature avoidance"]},{"id":"lenition","summary":"Consonants weaken, especially in high-frequency or intervocalic environments.","examples":["stop→fricative","stop→approximant","degemination"]},{"id":"fortition","summary":"Segments strengthen, often at prosodic or word edges.","examples":["fricative→stop","glide→fricative"]},{"id":"palatalization","summary":"Consonants shift toward palatal articulation near front vocoids.","examples":["k→tʃ / _i","t→ts / _j"]},{"id":"labialization","summary":"A segment gains lip rounding from neighboring rounded sounds.","examples":["k→kʷ / _u"]},{"id":"velarization","summary":"A segment gains secondary velar articulation.","examples":["l→ɫ in coda"]},{"id":"debuccalization","summary":"Place information weakens toward glottal articulation.","examples":["s→h","t→ʔ"]},{"id":"spirantization","summary":"A stop becomes a fricative.","examples":["p→f","k→x"]},{"id":"affrication","summary":"A stop/fricative develops stop+fricative timing.","examples":["t→ts","k→tʃ"]},{"id":"devoicing","summary":"Voiced segments lose voicing in a conditioning environment.","examples":["final devoicing"]},{"id":"voicing","summary":"Voiceless segments become voiced, commonly between voiced sounds.","examples":["intervocalic voicing"]},{"id":"vowel_reduction","summary":"Unstressed vowels centralize, shorten, or merge.","examples":["a,e,o→ə unstressed"]},{"id":"syncope","summary":"An internal segment, commonly an unstressed vowel, is lost.","examples":["V→∅ / weak syllable"]},{"id":"apocope","summary":"Word-final material is lost.","examples":["final vowel loss"]},{"id":"aphaeresis","summary":"Word-initial material is lost.","examples":["unstressed initial vowel loss"]},{"id":"epenthesis","summary":"A segment is inserted to satisfy phonotactics or improve perceptibility.","examples":["sC→əsC","CC→CVC"]},{"id":"prothesis","summary":"A segment is added at a word edge, especially initially.","examples":["sC→esC"]},{"id":"paragoge","summary":"A word-final segment is added.","examples":["final vowel support"]},{"id":"metathesis","summary":"Segments exchange positions.","examples":["CVr→CrV"]},{"id":"haplology","summary":"One of two similar adjacent syllables is removed.","examples":["...titi...→...ti..."]},{"id":"gemination","summary":"A consonant lengthens.","examples":["C→Cː"]},{"id":"degemination","summary":"A long consonant shortens.","examples":["Cː→C"]},{"id":"vowel_shift","summary":"Vowels move through the vowel space, sometimes as a chain.","examples":["raising","lowering","fronting","backing"]},{"id":"diphthongization","summary":"A monophthong develops a changing vowel quality.","examples":["eː→ei"]},{"id":"monophthongization","summary":"A diphthong simplifies to one vowel quality.","examples":["ai→eː"]},{"id":"tone_genesis","summary":"Segmental or laryngeal contrasts develop into pitch contrasts.","examples":["coda voicing conditions pitch then disappears"]},{"id":"merger","summary":"Two phonemes lose contrast.","examples":["/e ɛ/→/e/"]},{"id":"split","summary":"Conditioned variants become separate phonemes after environments change.","examples":["allophony→phonemic contrast"]},{"id":"chain_shift","summary":"Multiple contrasts move in linked fashion, avoiding or creating mergers.","examples":["vowel chain shift"]}]);const GRAMMAR_CHANGES=Object.freeze([{"id":"demonstrative_to_article","path":"demonstrative > definite article","mechanisms":["semantic bleaching","frequency","cliticization"]},{"id":"one_to_indefinite","path":"numeral one > indefinite article","mechanisms":["semantic bleaching","distribution expansion"]},{"id":"noun_to_adposition","path":"relational noun > adposition > case marker","mechanisms":["grammaticalization","phonological erosion"]},{"id":"verb_to_auxiliary","path":"lexical verb > auxiliary > tense/aspect marker","mechanisms":["grammaticalization","reanalysis"]},{"id":"pronoun_to_agreement","path":"pronoun > clitic > agreement affix","mechanisms":["cliticization","fusion"]},{"id":"case_erosion","path":"rich case marking > syncretism/loss > heavier reliance on order/adpositions","mechanisms":["phonological erosion","analogy"]},{"id":"case_growth","path":"adposition/clitic > bound case marker","mechanisms":["grammaticalization","agglutination"]},{"id":"plural_affix","path":"plural word/particle > clitic > plural affix","mechanisms":["frequency","cliticization"]},{"id":"analytic_to_synthetic","path":"free grammatical words > clitics > affixes","mechanisms":["erosion","fusion"]},{"id":"synthetic_to_analytic","path":"affix erosion > rigid syntax/new particles","mechanisms":["sound change","renewal"]},{"id":"negation_renewal","path":"old negator weakens; emphatic reinforcer becomes new negator","mechanisms":["bleaching","renewal"]},{"id":"word_order_reanalysis","path":"pragmatic alternation > frequent construction > default order","mechanisms":["frequency","contact","reanalysis"]},{"id":"agreement_leveling","path":"irregular agreement paradigms > analogically leveled forms","mechanisms":["analogy","frequency"]},{"id":"relative_marker","path":"demonstrative/interrogative > relative marker","mechanisms":["reanalysis","grammaticalization"]},{"id":"evidential_growth","path":"perception/report verb > evidential marker","mechanisms":["grammaticalization","semantic bleaching"]}]);const LEXICAL_CHANGES=Object.freeze([{"id":"borrowing","description":"A lexical item enters through contact and is adapted to the receiving phonology/phonotactics."},{"id":"calque","description":"A foreign expression is translated morpheme-by-morpheme rather than borrowed in form."},{"id":"semantic_broadening","description":"A word expands to a wider set of referents."},{"id":"semantic_narrowing","description":"A word becomes restricted to a narrower meaning."},{"id":"amelioration","description":"A word develops more positive associations."},{"id":"pejoration","description":"A word develops more negative associations."},{"id":"metaphor","description":"A lexical meaning extends through perceived similarity."},{"id":"metonymy","description":"A lexical meaning extends through contextual association."},{"id":"bleaching","description":"Specific lexical meaning weakens as a form becomes grammatical or discourse-functional."},{"id":"taboo_replacement","description":"A socially avoided form is replaced by euphemism, borrowing, or innovation."}]);const SLANG_PROCESSES=Object.freeze([{"id":"clipping","description":"Shorten an existing form while retaining recognizability."},{"id":"blending","description":"Fuse material from two forms."},{"id":"compounding","description":"Combine whole lexical bases."},{"id":"acronym","description":"Create a pronounceable or letter-name form from initials."},{"id":"initialism","description":"Create a letter-by-letter abbreviation."},{"id":"reduplication","description":"Repeat all or part of a form for expressive effect."},{"id":"respelling","description":"Alter spelling to signal pronunciation, identity, play, or platform constraints."},{"id":"semantic_shift","description":"Reuse an existing form with a new community-specific sense."},{"id":"conversion","description":"Move a form to a new grammatical category without overt affixation."},{"id":"borrowing","description":"Adopt a form from another language or community variety."},{"id":"backformation","description":"Remove a perceived affix to coin a new base."},{"id":"affixation","description":"Use productive affixes or emergent splinters to create new forms."}]);const EVENT_TYPES=Object.freeze([{"id":"migration","effects":["dialect contact","koineization","substrate/superstrate effects","new regional varieties"]},{"id":"conquest","effects":["prestige shift","elite bilingualism","borrowing","possible script replacement"]},{"id":"trade","effects":["loanwords","lingua-franca pressure","merchant jargon","phonetic accommodation"]},{"id":"religious_change","effects":["liturgical vocabulary","script conservatism or replacement","standardization"]},{"id":"state_centralization","effects":["standard language pressure","schooling","administrative vocabulary"]},{"id":"diaspora","effects":["heritage-language shift","contact innovations","identity marking"]},{"id":"isolation","effects":["local innovation","retention of archaic features","dialect divergence"]},{"id":"urbanization","effects":["dialect leveling","new-dialect formation","slang diffusion"]},{"id":"mass_schooling","effects":["orthographic standardization","prescriptive pressure","literacy expansion"]},{"id":"printing","effects":["spelling stabilization","standard variety expansion","visual conservatism"]},{"id":"digital_communication","effects":["rapid slang diffusion","abbreviation","orthographic play","cross-regional contact"]},{"id":"revitalization","effects":["new speakers","terminology creation","orthography planning","domain expansion"]},{"id":"population_decline","effects":["domain restriction","reduced transmission","possible structural leveling"]},{"id":"language_policy","effects":["prestige change","school domains","script reform","standardization"]}]);
const ATLAS=Object.freeze([["","","","","","","","","","","","","