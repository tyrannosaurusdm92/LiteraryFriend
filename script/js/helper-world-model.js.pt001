 function buildOriginalSupport(spec={}){const P=global.PeoplePlaces,world=generateWorld(spec);if(!world)return null;return {schema:'writer.original-support.v1',seed:world.seed||keyFor(spec),modes:world.settings?.modes||inferModes(spec.source_context,spec.premise),policy:'Optional original supporting material only. Project-defined characters and locations remain authoritative.',people:(world.people||[]).slice(0,16).map(compactPerson),places:(world.places||[]).slice(0,24).map(compactPlace),relationships:clone((world.relationships||[]).slice(0,40)),events:clone((world.events||[]).slice(-20)),statistics:P?.Statistics?.world?.(world)||null};}
 function searchOriginalSupport(spec={},query='',limit=12){const P=global.PeoplePlaces,world=generateWorld(spec);if(!world||!P?.SearchIndex)return[];return P.SearchIndex.query(P.SearchIndex.build(world),query,limit);}
 function simulateOriginalSupport(spec={},minutes=60){const P=global.PeoplePlaces,world=generateWorld(spec);if(!world||!P?.WorldSimulator)return null;P.WorldSimulator.advance(world,minutes);return buildOriginalSupport(spec);}
