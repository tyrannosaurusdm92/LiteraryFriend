function generate(random,age,opts={}){const r=random.fork('physical-description'),d=data(),heightBase=age<13?U.int(105,165,()=>r.next()):age<18?U.int(145,190,()=>r.next()):U.int(145,198,()=>r.next()),hairNatural=r.pick(d.hairColorsNatural||['brown','black','blonde','red']),dyed=r.chance(.18)?r.pick(d.hairColorsDyed||[]):null;return{heightCm:opts.heightCm||heightBase,build:opts.build||r.pick(d.builds||['average']),skinTone:opts.skinTone||r.pick(d.skinTones||[]),faceShape:r.pick(d.faceShapes||[]),eyeShape:r.pick(d.eyeShapes||[]),eyeColor:r.pick(d.eyeColors||[]),heterochromia:r.chance(.012)?{secondary:r.pick(d.eyeColors||[]),kind:r.pick(['complete','sectoral','central'])}:null,hair:{texture:r.pick(d.hairTextures||[]),style:r.pick(d.hairStyles||[]),color:hairNatural,dyedColor:dyed,facialHair:age>=15?r.pick(d.facialHair||['none']):'none'},notableFeatures:r.sample(d.notableFeatures||[],r.int(0,3)),clothingStyle:opts.clothingStyle||r.pick(d.clothingStyles||['practical everyday clothing']),accessibility:opts.accessibility|| (r.chance(.16)?r.pick((d.accessibility||['none']).filter(x=>x!=='none')):'none'),presentation:r.pick(d.presentationDetails||[]),notes:opts.presentationNotes||''}}
function describe(a){if(!a)return'';if(a.description)return a.description;const parts=[`${a.heightCm} cm tall with a ${a.build} build`,a.skinTone,`${a.eyeColor} ${a.eyeShape||''} eyes`,`${a.hair?.texture||''} ${a.hair?.style||''} ${a.hair?.dyedColor||a.hair?.color||''} hair`.replace(/\s+/g,' ').trim()];if(a.heterochromia)parts.push(`${a.heterochromia.kind} heterochromia`);if(a.notableFeatures?.length)parts.push(U.joinNatural(a.notableFeatures));if(a.speculativeTraits?.length)parts.push(U.joinNatural(a.speculativeTraits));if(a.clothingStyle)parts.push(a.clothingStyle);if(a.presentation)parts.push(a.presentation);if(a.accessibility&&a.accessibility!=='none')parts.push(`uses ${a.accessibility}`);if(a.notes)parts.push(a.notes);return parts.filter(Boolean).join('; ')}
P.register('PhysicalDescriptionEngine',{generate,describe});})(window);


/* ===== People+Places source: 10a-speculative-person-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils,D=P.SpeculativeData;
const fantasyJobs=['innkeeper','blacksmith','apothecary','healer','scholar','scribe','merchant','baker','guild artisan','courier','stable keeper','shipwright','guard','cartographer','teacher','musician','farmer','herbalist','alchemist','librarian','caravan worker','dock worker','performer','craftsperson','household manager'];
const scifiJobs=['systems technician','xenobiologist','navigator','station engineer','habitat coordinator','shuttle pilot','research specialist','medical technician','communications operator','sensor analyst','freight coordinator','hydroponics specialist','fabrication technician','colony planner','orbital mechanic','survey specialist','salvage technician','data archivist','diplomatic liaison','security specialist','mining operator','life-support technician','educator','scientist','ship crew member'];
function chooseSentient(random,mode,opts={}){if(mode==='realistic')return{id:'human',name:'Human',category:'Real-world people',profile:null,origin:'Realistic',note:'No speculative species template.',genre:'realistic',sentience:'sapient',nameFormat:'real-world'};const all=D.sentients.filter(x=>x.genre===mode);if(opts.sentientType){const wanted=all.find(x=>x.id===opts.sentientType||x.name===opts.sentientType);if(wanted)return wanted}if(mode==='scifi'){const derived=all.filter(x=>x.category==='Humans & Human Descendants'),other=all.filter(x=>x.category!=='Humans & Human Descendants');return random.chance(.84)?random.pick(other):random.pick(derived)}if(mode==='fantasy'){const human=all.find(x=>x.id==='human');return random.chance(.14)&&human?human:random.pick(all.filter(x=>x.id!=='human'))}return random.pick(all)}
function morphology(sentient,r){const n=sentient.name.toLowerCase(),c=sentient.category.toLowerCase(),traits=[];if(/digital|uploaded|virtual|software|artificial intelligence/.test(n)){traits.push('has no required fixed biological body');traits.push(r.pick(['usually communicates through projected interfaces','can inhabit compatible computing environments','uses a chosen interface identity']));return traits}if(/plasma|energy|photonic|gaseous|magnetospheric/.test(n)){traits.push(r.pick(['a luminous semi-coherent body','a diffuse body held in a stable field','a shifting non-solid silhouette']));traits.push(r.pick(['color varies with internal state','edges shimmer in motion','light and density change gradually']));return traits}if(/crystal|lithoid|silicon|metallic/.test(n)){traits.push(r.pick(['faceted mineral-like body surfaces','layered stone-like plates','crystalline structural growths']));traits.push(r.pick(['subtle internal luminescence','metallic veining','translucent edges']));return traits}if(/botanical|treeform|plant|fungal|lichen/.test(n)){traits.push(r.pick(['plantlike branching anatomy','fibrous botanical body tissues','fungal or lichen-like surface structures']));traits.push(r.pick(['seasonal color variation','spore-like decorative structures','leaflike sensory structures']));return traits}if(/cephalopod|jellyfish|deep-ocean|aquatic/.test(n)||c.includes('aquatic')){traits.push(r.pick(['aquatic-adapted body plan','flexible multi-limbed body','streamlined amphibious form']));traits.push(r.pick(['bioluminescent markings','iridescent skin','webbed or finlike structures']));return traits}if(/insect|mantis|arachnid|myriapod|crustacean/.test(n)){traits.push(r.pick(['segmented multi-limbed body plan','articulated exoskeletal body','paired sensory appendages']));traits.push(r.pick(['patterned carapace','fine sensory hairs','iridescent shell sections']));return traits}if(/avian|raptor|bat/.test(n)){traits.push(r.pick(['winged or wing-derived upper limbs','lightweight avian body plan','feathered or membrane-wing anatomy']));traits.push(r.pick(['patterned plumage','flight-adapted posture','large directional eyes']));return traits}if(/reptil|serpentine|dragon|draconic/.test(n)||c.includes('draconic')){traits.push(r.pick(['scaled skin','serpentine body elements','reptilian facial structure']));traits.push(r.pick(['subtle crest structures','heat-adapted scales','iridescent scale patterning']));return traits}if(/centaur/.test(n))traits.push('four-legged lower body with an upright sapient torso');
if(/satyr|faun/.test(n))traits.push('hoofed lower legs and horn structures');
if(/merfolk|mermaid|merman/.test(n))traits.push('aquatic lower body with fins and a humanoid upper torso');
if(/synthetic|android|robot|machine|construct/.test(n)||c.includes('synthetic')){traits.push(r.pick(['constructed humanoid chassis','modular synthetic body','engineered mechanical body']));traits.push(r.pick(['visible maintenance seams','soft-status lighting','replaceable outer panels']));return traits}
if(!traits.length&&sentient.genre!=='realistic')traits.push(r.pick(['humanoid body plan with species-specific features','sapient nonhuman physiology with individual variation','human-comparable posture with visibly nonhuman traits']));return traits}
function adaptPhysicalDescription(base,sentient,random){if(sentient.genre==='realistic')return base;const traits=morphology(sentient,random.fork('morphology')),nonHumanSci=sentient.genre==='scifi'&&sentient.category!=='Humans & Human Descendants'&&!/humanoid/i.test(sentient.name);if(nonHumanSci){return{description:`${sentient.name}; ${U.joinNatural(traits)}. Individual coloration, markings, body proportions, assistive technology, and presentation vary independently.`,speculative:true,sentientType:sentient.name,traits,accessibility:random.chance(.2)?random.pick(['mobility support system','sensory aid','communication interface','environmental support device','none']):'none'}}base.speculative=true;base.sentientType=sentient.name;base.speculativeTraits=traits;return base}
function adaptWorkEducation(we,mode,random){if(mode==='realistic')return we;const r=random.fork('genre-work');if(we.work.status==='employed')we.work.occupation=r.pick(mode==='scifi'?scifiJobs:fantasyJobs);if(we.education.status==='enrolled'){if(mode==='scifi'){we.education.type=r.pick(['station academy','colony learning center','technical institute','research apprenticeship','remote learning network']);we.education.field=r.pick(['navigation','engineering','medicine','xenoscience','ecology','communications','fabrication','history','arts','public service'])}else{we.education.type=r.pick(['academy','guild apprenticeship','scholars hall','monastic school','private tutor network']);we.education.field=r.pick(['letters','history','healing','craft','alchemy','navigation','natural study','music','trade','public service'])}}return we}
function settingProfile(sentient,mode){return{mode,sentientType:sentient.name,sentientTypeId:sentient.id,category:sentient.category,origin:sentient.origin,note:sentient.note||'',sentience:sentient.sentience||'sapient',guardrail:'Species/type influences only speculative body/name/location context; personality, morality, relationships, identity, and competence are generated independently.'}}
P.register('SpeculativePersonEngine',{chooseSentient,morphology,adaptPhysicalDescription,adaptWorkEducation,settingProfile});})(window);


/* ===== People+Places source: 11-personality-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs,U=P.Utils;
const facetMap={openness:['imagination','aesthetic sensitivity','intellectual curiosity','novelty seeking'],conscientiousness:['order','reliability','self-discipline','planning'],extraversion:['sociability','assertiveness','positive energy','stimulation seeking'],agreeableness:['compassion','cooperation','trust','tact'],emotionalSensitivity:['worry','stress reactivity','self-consciousness','emotional intensity']};
function generate(random,opts={}){const r=random.fork('personality'),bigFive={};for(const k of Object.keys(facetMap)){const score=r.int(18,92);bigFive[k]={score,facets:Object.fromEntries(facetMap[k].map(f=>[f,U.clamp100(score+r.int(-18,18))]))}}const traits=r.sample(C.traits,r.int(4,7)),values=r.sample(C.values,r.int(4,7));return{bigFive,traits,values,communicationStyles:r.sample(C.communicationStyles,r.int(2,4)),conflictStyle:r.pick(C.conflictStyles),attachmentTendency:r.pick(C.attachmentTendencies),socialBattery:r.int(20,95),riskTolerance:r.int(12,92),needForRoutine:r.int(10,95),privacyNeed:r.int(10,95),humor:r.pick(['dry','goofy','wordplay','sarcastic','observational','gentle','dark','earnest','absurdist','minimal']),decisionStyle:r.pick(['analytical','intuitive','consultative','fast','deliberate','values-first','practical']),stressSignals:r.sample(['gets quieter','talks faster','overplans','procrastinates','seeks company','isolates','cleans or organizes','jokes more','becomes blunt','asks for reassurance','focuses on tasks'],r.int(1,3)),comfortStrategies:r.sample(['music','quiet time','talking with someone trusted','movement','comfort food','creative work','games','reading','routine','nature','tidying','warm shower','pet time'],r.int(2,4)),quirks:r.sample(['keeps odd little collections','remembers tiny details','always has a backup plan','names household objects','hums while working','takes photos of interesting textures','makes lists for everything','sends long messages','sends one-word messages','rehearses difficult conversations','forgets where they put drinks','organizes by color','likes to sit in the same spot','carries snacks','checks the weather repeatedly'],r.int(1,3)),goals:r.sample(['build a stable home','master a craft','finish a major project','travel more','strengthen close relationships','change careers','continue education','save money','make more time for hobbies','become part of a community','start a business','publish or exhibit creative work','improve health routines','mentor someone'],r.int(1,3)),fears:r.sample(['letting people down','losing stability','being misunderstood','conflict with loved ones','stagnating','financial insecurity','failure in public','being controlled','being isolated','making an irreversible mistake','not having enough time'],r.int(1,2))}}
function compatibility(a,b){const va=new Set(a.values||[]),vb=new Set(b.values||[]);let shared=0;for(const x of va)if(vb.has(x))shared++;const valueScore=shared/Math.max(1,Math.max(va.size,vb.size));const commA=new Set(a.communicationStyles||[]),commB=new Set(b.communicationStyles||[]);let cs=0;for(const x of commA)if(commB.has(x))cs++;const commScore=cs/Math.max(1,Math.max(commA.size,commB.size));const extDiff=Math.abs((a.bigFive?.extraversion?.score||50)-(b.bigFive?.extraversion?.score||50))/100;return U.clamp100((valueScore*.5+commScore*.25+(1-extDiff)*.25)*100)}
P.register('PersonalityEngine',{generate,compatibility});})(window);


/* ===== People+Places source: 12-interest-skill-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs;
function generate(random,personality,age){const r=random.fork('interests');let hobbies=r.sample(C.hobbies,r.int(3,8));if(personality.traits.includes('bookish')&&!hobbies.includes('reading'))hobbies.unshift('reading');if(personality.traits.includes('musical')&&!hobbies.includes('music listening'))hobbies.unshift('music listening');const skills=r.sample(C.skills,r.int(4,9)).map(name=>({name,level:r.int(age<13?5:15,age<18?70:95),interest:r.int(25,100),years:Math.max(0,r.int(0,Math.min(age,25)))}));return{hobbies,skills,favoriteTopics:r.sample([...hobbies,...personality.values,'local life','work stories','food','media'],r.int(4,8)),dislikes:r.sample(['being rushed','loud crowded spaces','unplanned calls','bureaucracy','small talk','mess','rigid schedules','last-minute changes','wasting food','competitive social settings','early mornings','late nights'],r.int(1,4))}}
P.register('InterestSkillEngine',{generate});})(window);


/* ===== People+Places source: 13-mood-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs,U=P.Utils;
const profile={content:[.6,.35],joyful:[.9,.72],excited:[.8,.9],calm:[.55,.15],focused:[.3,.55],curious:[.45,.56],affectionate:[.78,.45],playful:[.8,.66],tired:[-.1,.12],bored:[-.25,.2],sad:[-.7,.25],lonely:[-.6,.3],anxious:[-.55,.82],tense:[-.55,.78],irritated:[-.45,.7],angry:[-.8,.9],embarrassed:[-.45,.62],hopeful:[.55,.5],inspired:[.75,.6],overwhelmed:[-.7,.92]};
function generate(random){const r=random.fork('mood'),label=r.pick(C.moods),p=profile[label]||[0,.4];return{label,valence:p[0],arousal:p[1],intensity:r.int(25,90),causes:[],since:new Date().toISOString()}}
function apply(mood,event){const m={...(mood||{label:'content',valence:.4,arousal:.3,intensity:40})},v=Number(event.valence||0),a=Number(event.arousal||0),weight=U.clamp(Number(event.weight??.25),0,1);m.valence=U.clamp(m.valence*(1-weight)+v*weight,-1,1);m.arousal=U.clamp(m.arousal*(1-weight)+a*weight,0,1);m.intensity=U.clamp100((Math.abs(m.valence)*.65+m.arousal*.35)*100);m.causes=[...(m.causes||[]),event.summary].filter(Boolean).slice(-5);let best='content',dist=Infinity;for(const [k,p] of Object.entries(profile)){const d=Math.hypot(m.valence-p[0],m.arousal-p[1]);if(d<dist){best=k;dist=d}}m.label=best;m.since=new Date().toISOString();return m}
P.register('MoodEngine',{generate,apply,profile});})(window);


/* ===== People+Places source: 14-life-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs;
function stageFor(age){return C.lifeStages.find(x=>age>=x.min&&age<=x.max)||C.lifeStages.at(-1)}
function age(random,requested){if(Number.isFinite(Number(requested)))return Math.max(0,Math.min(100,Math.round(Number(requested))));const r=random.fork('age'),roll=r.next();if(roll<.06)return r.int(0,5);if(roll<.18)return r.int(6,17);if(roll<.42)return r.int(18,29);if(roll<.74)return r.int(30,49);if(roll<.92)return r.int(50,69);return r.int(70,95)}
function generate(random,requested){const years=age(random,requested),stage=stageFor(years),month=random.fork('birth').int(1,12),day=random.fork('birth-day').int(1,28);return{age:years,stage,birthMonth:month,birthDay:day,isAdult:years>=18,isMinor:years<18}}
P.register('LifeEngine',{generate,stageFor});})(window);


/* ===== People+Places source: 15-work-education-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs;
function generate(random,life,interests){const r=random.fork('work-education'),age=life.age;let education={status:'none',type:null,field:null,level:null},work={status:'none',occupation:null,schedule:null};const fields=['arts','business','education','health','social sciences','computer science','engineering','trades','humanities','natural sciences','communications','hospitality','public service'];if(age>=6&&age<=17){education={status:'enrolled',type:age<11?'primary school':age<14?'middle school':'secondary school',field:'general studies',level:`year ${Math.max(1,age-5)}`}}else if(age>=18&&r.chance(age<30?.48:.12)){education={status:'enrolled',type:r.pick(C.schoolTypes.slice(5)),field:r.pick(fields),level:r.pick(['certificate','associate-level','bachelor-level','graduate','professional'])}}else if(age>=18){education={status:'completed / not currently enrolled',type:null,field:r.pick(fields),level:r.pick(['secondary credential','trade certificate','some college','associate-level degree','bachelor-level degree','graduate degree','professional degree'])}}if(age>=16&&age<70&&r.chance(age<18?.18:.82)){const occ=r.pick(C.occupations.filter(x=>x!=='retired'));work={status:'employed',occupation:occ,schedule:r.pick(['weekday daytime','weekday evening','night shift','rotating shifts','part-time flexible','weekend-heavy','self-scheduled','hybrid / mixed-location'])}}else if(age>=65){work={status:r.chance(.28)?'employed':'retired',occupation:r.chance(.28)?r.pick(C.occupations):'retired',schedule:'flexible'}}return{education,work}}
P.register('WorkEducationEngine',{generate});})(window);


/* ===== People+Places source: 16-location-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,C=P.Catalogs,U=P.Utils;
const prefixes=['Oak','Maple','Cedar','Willow','River','Stone','Pine','Birch','Harbor','Hill','Lake','North','South','East','West','Bright','Grand','Common','Union','Garden','Meadow','Silver','Juniper','Beacon'];const suffixes=['Court','House','Gardens','Commons','Center','Works','Hall','Place','Square','Station','Market','Studio','Park','School','Institute','Library','Clinic','Cafe','Shop','Apartments','Residences','Terrace','Heights'];
function fictionalCity(r){return `${r.pick(['Alder','Briar','Crescent','Fair','Glen','Harbor','Lake','Maple','North','Pine','River','Stone','West'])}${r.pick(['bridge','haven','field','view','port','wood','ridge','ford','dale','mont','bury'])}`}
function realisticRoles(kind){const residential=/house|apartment|condominium|residence|dormitory|townhouse|assisted living|retirement community/i.test(kind),school=/school|university|college|childcare/i.test(kind),work=!residential;return [...new Set(['visit',...(residential?['home']:[]),...(school?['school','work']:[]),...(work?['work']:[])])]}
function generateRealistic(random,opts={}){const r=random.fork('place-realistic'),kind=opts.kind||r.pick(C.placeKinds),city=opts.city||opts.settingContext?.cityName||fictionalCity(r),name=opts.name||`${r.pick(prefixes)} ${r.pick(suffixes)}`;return{id:opts.id||`place-${U.slug(name)}-${r.int(100,999)}`,seed:r.seed,name,kind,mode:'realistic',genre:'realistic',category:'Realistic place',texture:'realistic',assignmentKind:null,defaultAssignment:'',useRoles:realisticRoles(kind),geography:{country:opts.country||'Fictional / user-defined',region:opts.region||opts.settingContext?.regionName||'unspecified region',city,neighborhood:r.pick(['Central','Northside','Southside','Riverside','Old Town','Market District','University District','West End','East End','Garden District','Industrial Quarter','Lakeside'])},descriptors:r.sample(C.placeDescriptors,r.int(3,6)),accessibility:{stepFreeEntry:r.chance(.76),elevator:r.chance(.62),accessibleRestroom:r.chance(.66),quietSpace:r.chance(.42),transitAccess:r.chance(.72)},ambience:{noise:r.pick(['very quiet','quiet','moderate','busy','loud']),lighting:r.pick(['soft','bright','natural','dim','mixed']),crowding:r.pick(['sparse','light','moderate','busy','packed'])},capacity:r.int(4,250),openHours:kind.match(/house|apartment|condominium|residence|dormitory|townhouse/)?'residential':'varies by day',residents:[],workers:[],students:[],regulars:[],notes:opts.notes||'',visual:null}}
function generate(random,opts={}){const mode=opts.mode||'realistic';return mode==='realistic'?generateRealistic(random,opts):P.SpeculativeLocationEngine.generate(random,{...opts,mode})}
function describe(p){if(p.mode&&p.mode!=='realistic')return P.SpeculativeLocationEngine.describe(p);return `${p.name} is a ${p.descriptors.slice(0,3).join(', ')} ${p.kind} in ${p.geography.neighborhood}, ${p.geography.city}.`}
function assignmentFor(place,random){return place?.mode&&place.mode!=='realistic'?P.SpeculativeLocationEngine.assignmentFor(place,random):''}
P.register('LocationEngine',{generate,generateRealistic,describe,assignmentFor});})(window);


/* ===== People+Places source: 16a-speculative-location-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,D=P.SpeculativeData,U=P.Utils;
function cap(s){return s?String(s).charAt(0).toUpperCase()+String(s).slice(1):''}
function invented(bank,r){const p=bank.phonetic||D.locationWords.phonetic,n=r.int(p.syllables?.[0]||2,p.syllables?.[1]||3);let s='';for(let i=0;i<n;i++){s+=(r.pick(p.onset)||'')+(r.pick(p.nucleus)||'a');if(i===n-1&&r.chance(.6))s+=r.pick(p.coda)||''}s=s.replace(/([aeiou])\1+/gi,'$1').replace(/([a-z])\1\1+/gi,'$1$1');if(s.length>16)s=s.slice(0,16).replace(/[bcdfghjklmnpqrstvwxyz]+$/i,'');return cap(s||'Aster')}
function fantasyName(type,tone,mode,r){const d=D.locationWords;if(mode==='mixed'||!mode)mode=r.pick(['descriptive','descriptive','compound','invented']);if(mode==='descriptive'){const a=r.pick(d.tones[tone]||d.tones.neutral),generic=r.pick(type.generics);return{name:r.chance(.5)?`The ${a} ${generic}`:`${a} ${generic}`,mode}}if(mode==='compound'){const a=r.chance(.58)?r.pick(d.tones[tone]||d.tones.neutral):r.pick(d.nouns);return{name:`${a}${r.pick(d.suffixes)}`,mode}}return{name:`${invented(d,r)} ${r.pick(type.generics)}`,mode:'invented'}}
function scifiName(type,tone,mode,r){const d=D.locationWords.scifi;if(mode==='mixed'||!mode)mode=r.pick(['proper','proper','catalog','invented','descriptive']);const generic=r.pick(type.generics);if(mode==='catalog')return{name:`${r.pick(d.catalogPrefixes)}-${r.int(10,9999)}${r.chance(.35)?' '+String.fromCharCode(65+r.int(0,25)):''}`,mode};if(mode==='invented')return{name:`${invented(d,r)} ${generic}`,mode};if(mode==='descriptive')return{name:`${r.pick(d.adjectives)} ${generic}`,mode};const noun=type.scheme==='vessel'?r.pick(d.shipNouns):type.scheme==='station'?r.pick(d.stationNouns):type.scheme==='facility'?r.pick(d.facilityNouns):r.pick(d.celestialNouns);let name=`${r.pick(d.adjectives)} ${noun}`;if(type.scheme==='vessel'&&r.chance(.55))name=`${r.pick(d.vesselPrefixes)} ${name}`;return{name,mode:'proper'}}
function assignmentByKind(kind,r){switch(kind){case 'starship':return `Deck ${r.int(1,18)} · ${r.pick(['Cabin','Quarters','Berth','Compartment'])} ${r.int(1,48)}`;case 'station':return `${r.pick(['Ring','Module','Spoke','Sector'])} ${String.fromCharCode(65+r.int(0,7))} · Deck ${r.int(1,24)} · ${r.pick(['Cabin','Suite','Quarters','Dock'])} ${r.int(1,60)}`;case 'facility':return `Level ${r.int(1,12)} · ${r.pick(['Lab','Room','Unit','Bay','Suite'])} ${r.int(1,40)}`;case 'sector':return `${r.pick(['Survey Sector','Grid','Orbital Arc','Region'])} ${String.fromCharCode(65+r.int(0,25))}-${r.int(1,99)}`;case 'inn':return `Floor ${r.int(1,4)} · Room ${r.int(1,24)}`;case 'apartment':return `Floor ${r.int(1,8)} · Unit ${r.int(1,40)}`;case 'tavern':return `${r.pick(['Main Room','Upper Room','Private Room','Booth'])} ${r.int(1,12)}`;case 'castle':return `${r.pick(['North','South','East','West','Inner'])} ${r.pick(['Wing','Tower','Keep'])} · Chamber ${r.int(1,30)}`;case 'tower':return `Level ${r.int(1,12)} · Chamber ${r.int(1,18)}`;case 'library':return `${r.pick(['Gallery','Archive','Reading Room','Stack'])} ${String.fromCharCode(65+r.int(0,7))}-${r.int(1,20)}`;case 'shop':return `${r.pick(['Front Room','Workshop','Back Room','Loft'])} ${r.int(1,6)}`;case 'ship':return `Deck ${r.int(1,5)} · Cabin ${r.int(1,18)}`;case 'airship':return `Deck ${r.int(1,6)} · Cabin ${r.int(1,24)}`;case 'wagon':return `Wagon ${r.int(1,12)} · Berth ${r.int(1,8)}`;case 'bathhouse':case 'hall':case 'academy':case 'clinic':case 'lab':case 'warehouse':case 'stable':case 'dock':return `${r.pick(['Level','Hall','Room','Bay','Wing'])} ${r.int(1,20)}`;default:return ''}}
const pools={fantasy:{hub:['enchanted-village','market-town','river-town','mountain-town','port-town'],home:['apartment','boarding-house','inn','manor','castle'],school:['academy','library','scholars-guild','monastery'],work:['tavern','inn','library','apothecary','smithy','bakery','teahouse','bathhouse','theater','music-hall','academy','healer-house','alchemist-lab','observatory-fantasy','temple-building','monastery','warehouse','stable','dockhouse','guild-hall','artisan-guild','scholars-guild'],general:[]},scifi:{hub:['orbital-station','deep-space-station','ring-habitat','asteroid-habitat','trade-station','planetary-colony','lunar-colony','orbital-colony','asteroid-colony','frontier-colony','exploration-starship','colony-ship','generation-ship'],home:['residential-block','ring-habitat','cylinder-habitat','asteroid-habitat','orbital-station','planetary-colony','lunar-colony','orbital-colony','asteroid-colony','frontier-colony','colony-ship','generation-ship','passenger-liner'],school:['research-station','science-laboratory','observatory-station','colony-learning-center','station-academy'],work:['exploration-starship','research-vessel','freighter','courier-ship','salvage-vessel','hospital-ship','diplomatic-vessel','survey-cutter','mining-ship','orbital-station','deep-space-station','research-station','medical-station','observatory-station','mining-platform','refueling-station','shipyard-station','trade-station','relay-station','planetary-research-base','terraforming-facility','sensor-array','planetary-observatory','surface-port','orbital-dock','science-laboratory','medical-complex','industrial-complex','colony-learning-center','station-academy'],general:[]}};
function typeById(id){return D.locations.find(x=>x.id===id)}
function chooseType(r,genre,role='general'){const all=D.locations.filter(x=>x.genre===genre);if(role!=='general'&&pools[genre]?.[role]?.length){const pool=pools[genre][role].map(typeById).filter(Boolean);if(pool.length)return r.pick(pool)}if(genre==='scifi'){const rows=all.map(x=>({value:x,weight:x.category==='Colonies & Settlements'?5:x.category==='Stations & Habitats'?4:x.category==='Spacecraft'?3:x.category==='Astronomical Locations'?1.7:1.5}));return r.weighted(rows,'weight')?.value||r.pick(all)}const rows=all.map(x=>({value:x,weight:x.category==='Settlements & Communities'?5:x.id.includes('tavern')||x.id.includes('guild')?3:x.category==='Buildings & Interiors'?2:x.category==='Magical & Otherworldly'?1.8:1}));return r.weighted(rows,'weight')?.value||r.pick(all)}
function rolesFor(type){const out=['visit'];for(const [role,ids] of Object.entries(pools[type.genre]||{}))if(role!=='general'&&ids.includes(type.id))out.push(role);if(type.category==='Settlements & Communities'||type.category==='Colonies & Settlements')out.push('home','work','school');return [...new Set(out)]}
function capacity(type,r){if(type.category==='Astronomical Locations')return r.int(0,9999);if(type.category==='Settlements & Communities'||type.category==='Colonies & Settlements')return r.int(80,8000);if(type.scheme==='station')return r.int(80,3000);if(type.scheme==='vessel')return r.int(8,800);if(type.scheme==='facility')return r.int(15,600);return r.int(4,300)}
function generate(random,opts={}){const r=random.fork(`spec-place-${opts.mode||'fantasy'}-${opts.role||'general'}`),genre=opts.mode==='scifi'?'scifi':'fantasy',type=opts.typeId?typeById(opts.typeId):chooseType(r,genre,opts.role||'general'),tone=opts.tone||r.pick(genre==='fantasy'?['neutral','ancient','bright','wild','enchanted','eerie','coastal','frozen']:['neutral','bright','dark']),built=genre==='scifi'?scifiName(type,tone,opts.namingMode||'mixed',r):fantasyName(type,tone,opts.namingMode||'mixed',r),ctx=opts.settingContext||{},anchor=ctx.anchorName||ctx.settlementName||ctx.systemName||'the surrounding region',assignment=assignmentByKind(type.assignment,r);return{id:opts.id||`place-${U.slug(built.name)}-${r.int(100,999)}`,seed:r.seed,name:opts.name||built.name,kind:type.name,mode:genre,genre,locationTypeId:type.id,category:type.category,texture:type.texture,assignmentKind:type.assignment,defaultAssignment:assignment,useRoles:rolesFor(type),geography:genre==='scifi'?{country:'Interstellar / user-defined',region:ctx.systemName||'Unspecified star system',city:anchor,neighborhood:type.category}:{country:'Fictional / user-defined',region:ctx.realmName||'Unspecified realm',city:ctx.settlementName||anchor,neighborhood:type.category},descriptors:genre==='scifi'?r.sample(['pressurized','modular','remote','high-traffic','quiet','industrial','research-focused','residential','multispecies','automated','low-gravity','spin-gravity','shielded','windowed'],r.int(3,6)):r.sample(['enchanted','lantern-lit','weathered','welcoming','busy','quiet','wood-framed','stone-built','market-lined','garden-filled','river-adjacent','guild-run','old','bright','cozy'],r.int(3,6)),accessibility:{stepFreeEntry:r.chance(.82),elevator:genre==='scifi'?r.chance(.88):r.chance(.42),accessibleRestroom:r.chance(.72),quietSpace:r.chance(.55),transitAccess:r.chance(.75)},ambience:{noise:r.pick(['very quiet','quiet','moderate','busy','loud']),lighting:r.pick(genre==='scifi'?['soft panels','bright panels','natural-spectrum','dim','mixed','starlight-facing']:['firelight','lantern-lit','sunlit','dim','mixed','magical glow']),crowding:r.pick(['sparse','light','moderate','busy','packed'])},capacity:capacity(type,r),openHours:(opts.role==='home'||rolesFor(type).includes('home'))?'residential / continuous':r.pick(['08:00–17:00','09:00–18:00','10:00–22:00','24 hours','varies by cycle']),residents:[],workers:[],students:[],regulars:[],notes:opts.notes||'',source:{genre,typeId:type.id,tone,namingMode:built.mode}}}
function assignmentFor(place,random){if(!place||place.mode==='realistic')return'';return assignmentByKind(place.assignmentKind,random.fork(`assignment-${place.id}`))}
function describe(p){if(p.mode==='scifi')return `${p.name} is a ${p.descriptors.slice(0,3).join(', ')} ${p.kind} in ${p.geography.region}.`;if(p.mode==='fantasy')return `${p.name} is a ${p.descriptors.slice(0,3).join(', ')} ${p.kind} associated with ${p.geography.city}.`;return''}
P.register('SpeculativeLocationEngine',{generate,assignmentFor,describe,chooseType,typeById,pools});})(window);


/* ===== People+Places source: 16b-genre-coverage-expansion.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,D=P.SpeculativeData,E=P.SpeculativeLocationEngine;
const additions=[
// Fantasy settlement/location archetypes. These are original records using generic public-domain/common genre concepts.
{id:'sky-city',name:'Sky City',category:'Settlements & Communities',generics:['Sky City','Cloud City','Aerial Settlement'],texture:'sky',genre:'fantasy',scheme:'fantasy',assignment:'apartment'},
{id:'underwater-city',name:'Underwater City',category:'Settlements & Communities',generics:['Underwater City','Reef City','Submerged Settlement'],texture:'waters',genre:'fantasy',scheme:'fantasy',assignment:'apartment'},
{id:'necropolis-city',name:'Necropolis',category:'Settlements & Communities',generics:['Necropolis','Memorial City','City of Tombs'],texture:'shadow',genre:'fantasy',scheme:'fantasy',assignment:'apartment'},
{id:'kingdom-capital',name:'Kingdom Capital',category:'Settlements & Communities',generics:['Capital','Royal City','Crown City'],texture:'magical',genre:'fantasy',scheme:'fantasy',assignment:'apartment'},
{id:'magic-school',name:'Magic School',category:'Buildings & Interiors',generics:['Magic School','Arcane Academy','School of Magic'],texture:'magical',genre:'fantasy',scheme:'fantasy-building',assignment:'academy'},
{id:'magic-shop',name:'Magic Shop',category:'Buildings & Interiors',generics:['Magic Shop','Arcane Shop','Enchanted Goods Shop'],texture:'magical',genre:'fantasy',scheme:'fantasy-building',assignment:'shop'},
{id:'mage-tower',name:'Mage Tower',category:'Buildings & Interiors',generics:['Mage Tower','Wizard Tower','Arcane Tower'],texture:'magical',genre:'fantasy',scheme:'fantasy-building',assignment:'tower'},
{id:'market-square',name:'Market Square',category:'Buildings & Interiors',generics:['Market Square','Bazaar Court','Trade Square'],texture:'magical',genre:'fantasy',scheme:'fantasy-building',assignment:'hall'},
{id:'guild-district',name:'Guild District',category:'Settlements & Communities',generics:['Guild District','Craft Quarter','Guild Ward'],texture:'magical',genre:'fantasy',scheme:'fantasy',assignment:'hall'},
{id:'realm-gate',name:'Realm Gate',category:'Magical & Otherworldly',generics:['Realm Gate','World Gate','Arcane Passage'],texture:'magical',genre:'fantasy',scheme:'fantasy',assignment:'sector'},
// Sci-fi/space archetypes. Space remains the dominant frame whenever Sci-Fi is selected.
{id:'orbital-outpost',name:'Orbital Outpost',category:'Stations & Habitats',generics:['Orbital Outpost','Space Outpost','Orbital Enclave'],texture:'station',genre:'scifi',scheme:'station',assignment:'station'},
{id:'deep-space-outpost',name:'Deep-Space Outpost',category:'Stations & Habitats',generics:['Deep-Space Outpost','Frontier Station','Remote Outpost'],texture:'space',genre:'scifi',scheme:'station',assignment:'station'},
{id:'planetary-metropolis',name:'Planetary Metropolis',category:'Colonies & Settlements',generics:['Planetary Metropolis','Colony City','Planetary City'],texture:'planetary',genre:'scifi',scheme:'station',assignment:'station'},
{id:'dome-city',name:'Dome City',category:'Colonies & Settlements',generics:['Dome City','Pressure-Dome Settlement','Habitat City'],texture:'planetary',genre:'scifi',scheme:'station',assignment:'station'},
{id:'underwater-colony',name:'Underwater Colony',category:'Colonies & Settlements',generics:['Underwater Colony','Subsea Habitat','Oceanic Colony'],texture:'waters',genre:'scifi',scheme:'station',assignment:'station'},
{id:'moonbase',name:'Moonbase',category:'Colonies & Settlements',generics:['Moonbase','Lunar Base','Lunar Settlement'],texture:'planetary',genre:'scifi',scheme:'station',assignment:'station'},
{id:'comet-mining-base',name:'Comet Mining Base',category:'Facilities & Interiors',generics:['Comet Mining Base','Ice-Mining Base','Comet Facility'],texture:'facility',genre:'scifi',scheme:'facility',assignment:'facility'},
{id:'mecha-bay',name:'Mecha Bay',category:'Facilities & Interiors',generics:['Mecha Bay','Heavy Robotics Bay','Machine Hangar'],texture:'facility',genre:'scifi',scheme:'facility',assignment:'facility'},
{id:'satellite-array',name:'Satellite Array',category:'Astronomical Locations',generics:['Satellite Array','Orbital Satellite Network','Sensor Constellation'],texture:'space',genre:'scifi',scheme:'celestial',assignment:'sector'},
{id:'asteroid-belt',name:'Asteroid Belt',category:'Astronomical Locations',generics:['Asteroid Belt','Rock Belt','Minor-Planet Belt'],texture:'space',genre:'scifi',scheme:'celestial',assignment:'sector'},
{id:'black-hole-observatory',name:'Black-Hole Observatory',category:'Facilities & Interiors',generics:['Black-Hole Observatory','Relativity Observatory','Deep-Gravity Observatory'],texture:'cosmic',genre:'scifi',scheme:'facility',assignment:'facility'},
{id:'exoplanet',name:'Exoplanet',category:'Astronomical Locations',generics:['Exoplanet','Outer World','Survey World'],texture:'planetary',genre:'scifi',scheme:'celestial',assignment:'sector'},
{id:'quasar-sector',name:'Quasar Sector',category:'Astronomical Locations',generics:['Quasar Sector','Active-Galaxy Sector','High-Energy Survey Region'],texture:'cosmic',genre:'scifi',scheme:'celestial',assignment:'sector'}
];
const existing=new Set(D.locations.map(x=>x.id));for(const x of additions)if(!existing.has(x.id)){D.locations.push(x);existing.add(x.id)}
function add(pool,ids){for(const id of ids)if(!pool.includes(id))pool.push(id)}
add(E.pools.fantasy.hub,['sky-city','underwater-city','necropolis-city','kingdom-capital']);
add(E.pools.fantasy.home,['sky-city','underwater-city','kingdom-capital','guild-district']);
add(E.pools.fantasy.school,['magic-school','mage-tower']);
add(E.pools.fantasy.work,['magic-school','magic-shop','mage-tower','market-square','guild-district']);
add(E.pools.scifi.hub,['orbital-outpost','deep-space-outpost','planetary-metropolis','dome-city','underwater-colony','moonbase']);
add(E.pools.scifi.home,['orbital-outpost','planetary-metropolis','dome-city','underwater-colony','moonbase']);
add(E.pools.scifi.work,['orbital-outpost','deep-space-outpost','planetary-metropolis','dome-city','underwater-colony','moonbase','comet-mining-base','mecha-bay','black-hole-observatory']);
P.register('GenreCoverageExpansion',{additions:additions.map(x=>x.id),researchBasis:'Public generator-category coverage was consulted for breadth; no FantasyNameGenerators.com name lists or generator output are bundled.'});})(window);



/* ===== People+Places source: 17-routine-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces;
const blocks=['00:00','06:00','07:00','08:00','09:00','12:00','13:00','15:00','17:00','18:00','20:00','22:00','23:00'];
function makeDay(random,person,dayType='weekday'){const r=random.fork(`routine-${dayType}`),life=person.life,rows=[];const push=(time,activity,placeId=null)=>rows.push({time,activity,placeId});push('00:00','sleeping',person.life.homePlaceId);push(r.pick(['06:00','07:00','08:00']),'getting ready',person.life.homePlaceId);push(r.pick(['07:00','08:00','09:00']),'eating breakfast',person.life.homePlaceId);if(dayType==='weekday'&&life.schoolPlaceId)push('09:00','attending class',life.schoolPlaceId);else if(dayType==='weekday'&&life.workPlaceId)push(r.pick(['08:00','09:00']),'working',life.workPlaceId);else push('10:00',r.pick(person.interests.hobbies),person.life.homePlaceId);push('12:00','eating lunch',dayType==='weekday'?(life.workPlaceId||life.schoolPlaceId||life.homePlaceId):life.homePlaceId);push('17:00',r.pick(['commuting','running errands','doing chores','resting']),person.life.homePlaceId);push('19:00',r.pick(person.interests.hobbies),person.life.homePlaceId);push('22:00','night routine',person.life.homePlaceId);return rows}
function generate(random,person){return{weekday:makeDay(random,person,'weekday'),weekend:makeDay(random,person,'weekend')}}
function activityAt(schedule,date=new Date()){const rows=(date.getDay()===0||date.getDay()===6)?schedule.weekend:schedule.weekday;const hh=String(date.getHours()).padStart(2,'0')+':'+String(date.getMinutes()).padStart(2,'0');let current=rows[0];for(const row of rows)if(row.time<=hh)current=row;return current}
P.register('RoutineEngine',{generate,activityAt,blocks});})(window);


/* ===== People+Places source: 18-relationship-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function edge(a,b,kind,random,opts={}){const r=random.fork(`rel-${a.id}-${b.id}-${kind}`);return{id:`rel-${a.id}-${b.id}-${U.slug(kind)}`,aId:a.id,bId:b.id,kind,romantic:['partner','spouse','date','ex-partner'].includes(kind),family:['parent','child','sibling','grandparent','grandchild','cousin','guardian','dependent'].includes(kind),closeness:opts.closeness??r.int(25,98),trust:opts.trust??r.int(20,98),attraction:opts.attraction??((a.life.age>=18&&b.life.age>=18)?r.int(0,100):0),tension:opts.tension??r.int(0,45),historyMonths:opts.historyMonths??r.int(1,240),consent:{knownToBoth:true,agreedFramework:opts.framework||null},labels:opts.labels||[],notes:opts.notes||''}}
function other(e,id){return e.aId===id?e.bId:e.aId}
function linksFor(world,id){return world.relationships.filter(e=>e.aId===id||e.bId===id)}
function romanticLinks(world,id){return linksFor(world,id).filter(e=>e.romantic&&e.kind!=='ex-partner')}
function canAddRomance(world,a,b){if(a.life.age<18||b.life.age<18)return false;if(a.id===b.id)return false;if(romanticLinks(world,a.id).some(e=>other(e,a.id)===b.id))return false;const fa=a.identity.relationshipFramework,fb=b.identity.relationshipFramework;if(fa==='not-seeking'||fb==='not-seeking')return false;const max=x=>({monogamous:1,polyamorous:5,open:3,'solo-poly':4,'relationship-anarchy':6}[x]??1);return romanticLinks(world,a.id).length<max(fa)&&romanticLinks(world,b.id).length<max(fb)}
function generateSocialEdge(random,a,b){const r=random.fork(`social-${a.id}-${b.id}`);const shared=P.PersonalityEngine.compatibility(a.personality,b.personality);let kind=shared>78?r.pick(['close friend','best friend']):shared>58?r.pick(['friend','coworker','neighbor','classmate']):r.pick(['acquaintance','neighbor','coworker','community member']);return edge(a,b,kind,r,{closeness:Math.round(shared*.8+r.int(0,20))})}
P.register('RelationshipEngine',{edge,other,linksFor,romanticLinks,canAddRomance,generateSocialEdge});})(window);


/* ===== People+Places source: 19-social-graph-engine.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,R=P.RelationshipEngine;
function build(world,random,opts={}){const people=world.people,edges=[];world.relationships=edges;for(let i=0;i<people.length;i++){for(let j=i+1;j<people.length;j++){const a=people[i],b=people[j],r=random.fork(`pair-${i}-${j}`);if(r.chance(opts.socialDensity??Math.min(.18,5/Math.max(5,people.length))))edges.push(R.generateSocialEdge(r,a,b))}}
// Create sibling/family ties for some people in close age/geography bands.
for(let i=0;i<people.length-1;i++){const a=people[i],b=people[i+1],r=random.fork(`family-${i}`);if(Math.abs(a.life.age-b.life.age)<=14&&r.chance(.12)&&!edges.some(e=>R.other(e,a.id)===b.id&&(e.aId===a.id||e.bId===a.id)))edges.push(R.edge(a,b,'sibling',r,{closeness:r.int(35,95)}))}
// Adult romantic networks: mixed monogamous and consensually non-monogamous structures.
const adults=people.filter(x=>x.life.age>=18);for(const a of adults){const r=random.fork(`romance-${a.id}`);if(r.chance(.42)){const candidates=r.shuffle(adults.filter(b=>R.canAddRomance(world,a,b))).sort((x,y)=>P.PersonalityEngine.compatibility(a.personality,y.personality)-P.PersonalityEngine.compatibility(a.personality,x.personality));const wanted=a.identity.relationshipFramework==='monogamous'?1:a.identity.relationshipFramework==='not-seeking'?0:r.int(1,Math.min(3,candidates.length));for(const b of candidates.slice(0,wanted)){if(!R.canAddRomance(world,a,b))continue;const kind=r.pick(['partner','partner','partner','spouse','date']),framework=a.identity.relationshipFramework===b.identity.relationshipFramework?a.identity.relationshipFramework:`negotiated:${a.identity.relationshipFramework}+${b.identity.relationshipFramework}`;edges.push(R.edge(a,b,kind,r,{closeness:r.int(50,98),trust:r.int(45,98),attraction:r.int(45,100),framework}))}}}
// Metamour edges are explicit social links between people sharing a partner.
for(const pivot of adults){const rs=R.romanticLinks(world,pivot.id),partners=rs.map(e=>people.find(x=>x.id===R.other(e,pivot.id))).filter(Boolean);for(let i=0;i<partners.length;i++)for(let j=i+1;j<partners.length;j++){const a=partners[i],b=partners[j];if(!edges.some(e=>(e.aId===a.id&&e.bId===b.id)||(e.aId===b.id&&e.bId===a.id)))edges.push(R.edge(a,b,'metamour',random.fork(`meta-${a.id}-${b.id}`),{closeness:random.fork(`mc-${a.id}`).int(10,85)}))}}
return edges}
P.register('SocialGraphEngine',{build});})(window);


/* ===== People+Places source: 20-memory-store.js ===== */
(function(g){"use strict";const P=g.PeoplePlaces,U=P.Utils;
function ensure(person){person.memory=person.memory||{profile:'average',records:[],working:[],updatedAt:U.nowISO()};return person.memory}
function add(person,record){const m=ensure(person),now=record.createdAt||U.nowISO(),r={id:record.id||U.uid('mem'),kind:record.kind||'episodic',summary:U.normalizeText(record.summary),entities:U.unique(record.entities||[]),tags:U.unique(record.tags||[]),emotionalWeight:U.clamp(Number(record.emotionalWeight??.3),0,1),confidence:U.clamp(Number(record.confidence??.9),0,1),salience:U.clamp(Number(record.salience??.5),0,1),privacy:record.privacy||'normal',source:record.source||'experience',createdAt:now,lastRecalledAt:record.lastRecalledAt||null,recallCount:record.recallCount||0,halfLifeDays:record.halfLifeDays||120,relationshipImpact:record.relationshipImpact||{}};const dupe=m.records.find(x=>x.kind===r.kind&&x.summary.toLowerCase()===r.summary.toLowerCase());if(dupe){dupe.confidence=Math.min(1,Math.max(dupe.confidence,r.confidence)+.05);dupe.salience=Math.min(1,Math.max(dupe.salience,r.salience)+.05);dupe.recallCount++;m.updatedAt=U.nowISO();return dupe}m.records.push(r);if(m.records.length>1200)m.records.splice(0,m.records.length-1200);m.working.push(r.id);m.working=m.working.slice(-12);m.updatedAt=U.nowISO();return r}
function reinforce(person,id,amount=.08){const r=ensure(person).records.find(x=>x.id===id);if(!r)return null;r.confidence=U.clamp(r.confidence+amount,0,1);r.salience=U.clamp(r.salience+amount/2,0,1);r.lastRecalledAt=U.nowISO();r.recallCount++;return r}
function decay(person,now=new Date()){for(const r of ensure(person).records){const days=(now-new Date(r.lastRecalledAt||r.createdAt))/86400000,half=Math.max(7,r.halfLifeDays||120),factor=Math.pow(.5,days/half);r.confidence=U.clamp(r.confidence*factor+.05,0,1);r.salience=U.clamp(r.salience*Math.pow(.65,days/half)+r.emotionalWeight*.15,0,1)}return person.memory}
