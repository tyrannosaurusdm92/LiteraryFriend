const MOTIFS=Object.freeze({water:'waves',river:'waves',sea:'waves',sun:'sun',moon:'crescent',star:'star',house:'house',home:'house',eye:'eye',head:'head',person:'person',man:'person',woman:'person',hand:'hand',foot:'foot',tree:'tree',plant:'tree',snake:'snake',serpent:'snake',fish:'fish',bird:'bird',mountain:'mountain',hill:'mountain',fire:'fire',flame:'fire',door:'door',road:'road',path:'road',ox:'horns',bull:'horns',cow:'horns',mouth:'mouth',tooth:'teeth',weapon:'spear',spear:'spear',king:'crown',god:'star',spirit:'spiral',wind:'spiral',heart:'heart',love:'heart',book:'tablet',writing:'tablet'});
function motifFor(meaning='',sound='',seed=''){const s=String(meaning).toLowerCase();for(const [k,v] of Object.entries(MOTIFS))if(s.includes(k))return v;const opts=['cross','fork','ladder','zigzag','loop','arch','chevron','hook','diamond','spiral','trident','gate'];return opts[hash(`${seed}:${meaning}:${sound}`)%opts.length];}
function P(x,y){return {x,y}};
function motif(name,r){const cx=500,cy=500;switch(name){case'waves':return [[P(130,430),P(260,360),P(390,430),P(520,360),P(650,430),P(790,360)],[P(160,610),P(290,540),P(420,610),P(550,540),P(680,610),P(810,540)]];case'sun':return [[P(500,230),P(660,300),P(735,465),P(690,640),P(530,740),P(355,690),P(260,530),P(300,355),P(500,230)],[P(500,120),P(500,210)],[P(500,760),P(500,850)],[P(180,500),P(270,500)],[P(730,500),P(820,500)]];case'crescent':return [[P(650,220),P(470,260),P(360,410),P(350,590),P(450,730),P(640,770)],[P(640,770),P(520,660),P(490,510),P(520,360),P(650,220)]];case'star':return [[P(500,140),P(570,400),P(835,400),P(620,555),P(700,820),P(500,655),P(300,820),P(380,555),P(165,400),P(430,400),P(500,140)]];case'house':return [[P(210,470),P(500,190),P(790,470)],[P(290,430),P(290,790),P(710,790),P(710,430)],[P(470,790),P(470,590),P(585,590),P(585,790)]];case'eye':return [[P(170,500),P(330,360),P(500,325),P(670,360),P(830,500),P(670,640),P(500,675),P(330,640),P(170,500)],[P(500,390),P(500,610)]];case'head':return [[P(360,180),P(650,240),P(720,470),P(650,700),P(430,800),P(300,620),P(300,360),P(360,180)],[P(410,430),P(470,430)],[P(540,430),P(600,430)]];case'person':return [[P(500,170),P(500,410),P(500,780)],[P(500,400),P(260,570)],[P(500,400),P(740,570)],[P(500,780),P(330,880)],[P(500,780),P(670,880)]];case'hand':return [[P(260,770),P(360,520),P(390,250)],[P(360,520),P(470,220)],[P(390,540),P(575,260)],[P(420,590),P(680,370)],[P(260,770),P(590,800)]];case'tree':return [[P(500,820),P(500,270)],[P(500,390),P(310,240)],[P(500,390),P(690,240)],[P(500,530),P(280,470)],[P(500,530),P(720,470)],[P(350,820),P(650,820)]];case'snake':return [[P(260,210),P(680,260),P(720,430),P(300,470),P(260,650),P(700,730),P(760,840)]];case'fish':return [[P(190,500),P(360,340),P(610,360),P(800,500),P(610,640),P(360,660),P(190,500)],[P(190,500),P(80,360),P(80,640),P(190,500)]];case'bird':return [[P(160,560),P(390,350),P(500,520),P(610,350),P(840,560)],[P(500,520),P(500,760)]];case'mountain':return [[P(130,760),P(365,300),P(510,570),P(640,260),P(860,760)]];case'fire':return [[P(490,820),P(320,650),P(420,470),P(380,300),P(540,450),P(610,210),P(700,510),P(640,720),P(490,820)]];case'door':return [[P(280,820),P(280,240),P(720,240),P(720,820)],[P(500,820),P(500,470),P(650,470),P(650,820)]];case'road':return [[P(320,850),P(430,650),P(370,480),P(520,320),P(600,150)],[P(580,850),P(620,660),P(560,500),P(670,340),P(720,160)]];case'horns':return [[P(500,760),P(500,340)],[P(500,340),P(290,200),P(200,330)],[P(500,340),P(710,200),P(800,330)]];case'mouth':return [[P(200,500),P(360,380),P(640,380),P(800,500),P(640,620),P(360,620),P(200,500)]];case'teeth':return [[P(180,400),P(820,400)],[P(180,650),P(820,650)],[P(300,400),P(350,650)],[P(470,400),P(500,650)],[P(650,400),P(610,650)]];case'spear':return [[P(500,850),P(500,260)],[P(500,180),P(400,330),P(600,330),P(500,180)]];case'crown':return [[P(220,690),P(180,320),P(380,480),P(500,250),P(620,480),P(820,320),P(780,690),P(220,690)]];case'spiral':{const a=[];for(let i=0;i<22;i++){const t=i*.65,rad=20+i*15;a.push(P(cx+Math.cos(t)*rad,cy+Math.sin(t)*rad));}return[a]}case'heart':return [[P(500,820),P(250,570),P(220,370),P(360,260),P(500,390),P(640,260),P(780,370),P(750,570),P(500,820)]];case'tablet':return [[P(250,220),P(750,220),P(750,790),P(250,790),P(250,220)],[P(340,360),P(660,360)],[P(340,500),P(660,500)],[P(340,640),P(610,640)]];case'fork':return [[P(500,830),P(500,450),P(280,220)],[P(500,450),P(720,220)]];case'ladder':return [[P(310,820),P(310,190)],[P(690,820),P(690,190)],[P(310,350),P(690,350)],[P(310,520),P(690,520)],[P(310,690),P(690,690)]];case'zigzag':return [[P(180,250),P(420,420),P(250,590),P(520,760),P(790,560),P(650,330)]];case'loop':return [[P(500,180),P(720,330),P(720,620),P(500,800),P(280,620),P(280,330),P(500,180)],[P(500,180),P(500,800)]];case'arch':return [[P(240,820),P(250,430),P(360,250),P(500,190),P(640,250),P(750,430),P(760,820)]];case'chevron':return [[P(180,280),P(500,720),P(820,280)]];case'hook':ret