function outline(strokes,style={}){const width=Number(style.stroke||64),contours=[];for(const line of strokes){for(let i=1;i<line.length;i++)contours.push(segmentOutline(line[i-1],line[i],width));if(style.round>0.4){for(const p of line)contours.push(circle(p.x,p.y,width/2,10));}}return contours;}
function metrics(contours=[],style={}){const pts=contours.flat();if(!pts.length)return {advanceWidth:700,leftSideBearing:50,bbox:{xMin:0,yMin:0,xMax:600,yMax:700}};const xs=pts.map(p=>p.x),ys=pts.map(p=>p.y),xMin=Math.min(...xs),xMax=Math.max(...xs),yMin=Math.min(...ys),yMax=Math.max(...ys),side=Number(style.sideBearing||70);return {advanceWidth:Math.ceil(xMax-xMin+side*2),leftSideBearing:side,bbox:{xMin,yMin,xMax,yMax}};}
function synthesize(input={}){const r=rng(input.seed||`${input.meaning}:${input.sound}:${input.id}`),medium=input.medium||'stone',base={...MEDIA[medium],...(input.style||{})},motifName=input.motif||motifFor(input.meaning,input.sound,input.seed),skeleton=transform(motif(motifName,r),base,input.seed||input.id||motifName),contours=outline(skeleton,base),m=metrics(contours,base);return {...clone(input),motif:motifName,medium,style:base,skeleton,contours,advanceWidth:input.advanceWidth||m.advanceWidth,leftSideBearing:m.leftSideBearing,bbox:m.bbox,procedural:true};}
function evolveGlyph(glyph={},history=[],opts={}){let g=clone(glyph),style={...(glyph.style||{})};for(const h of history||[]){const reason=String(h.reason||'').toLowerCase();if(/stone|carv/.test(reason)){style={...style,...MEDIA.stone};}if(/brush|ink/.test(reason)){style={...style,...MEDIA.brush};}if(/curs/.test(reason)){style={...style,...MEDIA.cursive};style.slant=(style.slant||0)+.1;}if(/print|standard/.test(reason)){style={...style,...MEDIA.print};style.noise=0;}if(/screen|digital/.test(reason)){style={...style,...MEDIA.screen};}if(/simplif|rapid/.test(reason)){style.widthScale=(style.widthScale||1)*.88;style.rotation=(style.rotation||0)+(opts.rotationStep||2);}}return synthesize({...g,style,seed:`${opts.seed||g.id}:evolved`});}
function variants(glyph={},count=3,opts={}){const out=[];for(let i=0;i<count;i++)out.push(synthesize({...glyph,style:{...(glyph.style||{}),noise:Math.max(.008,Number(glyph.style?.noise||.015))+(i+1)*.004,slant:Number(glyph.style?.slant||0)+(i-(count-1)/2)*.025},seed:`${opts.seed||glyph.id}:variant:${i}`}));return out;}
function ligature(a,b,opts={}){const A=clone(a.contours||[]),B=clone(b.contours||[]),shift=Number(a.advanceWidth||700)*.66,scale=.78,map=(cs,dx)=>cs.map(c=>c.map(p=>({x:p.x*scale+dx,y:p.y})));const contours=[...map(A,0),...map(B,shift)];return {id:`liga-${a.id||a.name}-${b.id||b.name}`,name:`${a.name||a.id}_${b.name||b.id}`,components:[a.id||a.name,b.id||b.name],contours,advanceWidth:Math.ceil(shift+(b.advanceWidth||700)*scale),ligature:true};}
function synthesizeAlphabet(symbols=[],opts={}){return symbols.map((s,i)=>s.contours?.length?clone(s):synthesize({...s,medium:s.medium||opts.medium||'stone',style:{...(opts.style||{}),...(s.style||{})},seed:`${opts.seed||'alphabet'}:${s.id||i}:${s.meaning}:${s.sound}`}));}
function attachToScript(scriptResult={},opts={}){const out=clone(scriptResult),modern=out.modern||out.stages?.at(-1);if(!modern)return out;modern.symbols=synthesizeAlphabet(modern.symbols||[],opts).map(s=>s.contours?.length?s:evolveGlyph(s,s.history||[],opts));out.modern=modern;if(Array.isArray(out.stages)&&out.stages.length)out.stages[out.stages.length-1]=modern;if(global.WriterToolsScriptEvolution?.buildEvolutionTable)out.letterEvolutionTable=global.WriterToolsScriptEvolution.buildEvolutionTable(modern.symbols||[],modern.retiredSymbols||[]);return out;}
async function buildTTF(symbols=[],opts={}){if(!global.WriterToolsFontTTF)throw new Error('helper-creative.js must be loaded');const glyphs=synthesizeAlphabet(symbols,opts).map((s,i)=>({name:s.name||s.id||`glyph${i}`,unicode:s.codePoint??0xE000+i,contours:s.contours,advanceWidth:s.advanceWidth||700,meaning:s.meaning,sound:s.sound}));return global.WriterToolsFontTTF.buildTTF(glyphs,{familyName:opts.familyName||'Procedural Evolved Script',styleName:opts.styleName||'Regular'});}
async function ungzip64(b64){const bin=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));if(typeof DecompressionStream!=='undefined'){const ab=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();return new TextDecoder().decode(ab);}if(global.pako?.ungzip)return new TextDecoder().decode(global.pako.ungzip(bin));throw new Error('No gzip decompressor available.');}
