function linesFor(result={}){const modern=result.modern||result,script=result.scriptEvolution?.modern||result.scriptEvolution?.stages?.slice(-1)[0],table=result.scriptEvolution?.letterEvolutionTable||[];const L=[];L.push(`# ${result.name||modern.name||'Language'} — Language & Writing System Reference`,``,`Time depth: ${result.years??modern.year??'unspecified'} years`,``,`## Research-model caveat`,`This is a plausible constructed-language evolution generated from supplied inputs and historical pressures. It is not a prediction of what real speakers must do. Language change is socially distributed, can be irregular, and orthography may lag behind or be deliberately reformed.`,``,`## Sound system`,`Phoneme inventory: ${(modern.phonemes||[]).join(' ')}`,`Phonotactics: ${JSON.stringify(modern.phonotactics||{},null,2)}`,`` ,`## Grammar`);for(const [k,v] of Object.entries(modern.grammar||{}))L.push(`${k}: ${Array.isArray(v)?v.join(', '):v}`);L.push('',`## Historical stages`);for(const s of result.stages||[]) {L.push(`### Year ${s.year}`);for(const c of s.changes||[])L.push(`- ${c.domain||'change'}: ${c.rule||c.change||c.id||c.event||JSON.stringify(c)}`);if(s.vitality)L.push(`- vitality: ${s.vitality.status} (${Number(s.vitality.score||0).toFixed(2)})`);}
 if(script){L.push('',`## Writing system`,`Type: ${script.scriptType||''}`,`Direction: ${script.direction||''}`,``,`## Alphabet / sign inventory`);for(const s of script.symbols||[]){const cp=Number.isInteger(s.codePoint)?s.codePoint:null,display=cp?String.fromCodePoint(cp):(s.glyph||'');L.push(`- ${display} ${s.name||s.id}: /${s.sound||''}/ — ${s.meaning||''} — ${cp?'U+'+cp.toString(16).toUpperCase().padStart(4,'0'):''}`);}}if(table.length){L.push('',`## Letter evolution table`);for(const row of table)L.push(`- ${row.id}: status=${row.status||'active'}${row.retiredYear!=null?`; retired year=${row.retiredYear}`:''}; meaning=${row.ancestralMeaning}; ancestor word=${row.ancestralWord}; acrophonic base=${row.acrophonicBase}; modern sound=${row.modernSound}; modern letter name=${row.modernLetterName}; ${row.codePoint}`);}L.push('',`## Lexicon`);for(const e of (modern.lexicon||[]).slice(0,5000))L.push(`${e.form}\t${e.meaning||''}${e.sourceLanguage?`\t[loan from ${e.sourceLanguage}: ${e.sourceForm||''}]`:''}`);return L;}
