';let cache=null;async function load(){if(cache)return cache;const bin=Uint8Array.from(atob(PACK),c=>c.charCodeAt(0));let text;if(typeof DecompressionStream!=='undefined'){const ab=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();text=new TextDecoder().decode(ab);}else if(global.pako?.ungzip)text=new TextDecoder().decode(global.pako.ungzip(bin));else throw new Error('Deep research atlas requires browser DecompressionStream or pako.');cache=text.split(/\n/).filter(Boolean).map(JSON.parse);return cache;}async function search(query={},limit=24){const rows=await load(),terms=String(query.text||query.q||'').toLowerCase().split(/\W+/).filter(Boolean),kind=query.kind||null;let pool=rows;if(kind)pool=pool.filter(x=>x.id.startsWith(kind));if(terms.length)pool=pool.map(x=>({x,score:terms.reduce((n,t)=>n+(JSON.stringify(x).toLowerCase().includes(t)?1:0),0)})).filter(y=>y.score).sort((a,b)=>b.score-a.score).map(y=>y.x);return pool.slice(0,Math.max(1,Number(limit||24)));}global.WriterHelperDeepResearchAtlas=Object.freeze({META,load,search});})(typeof globalThis!=='undefined'?globalThis:window);


if (typeof globalThis !== 'undefined') { globalThis.WRITER_HELPER_READY_BUILD = globalThis.WRITER_HELPER_READY_BUILD || '2026-09-22-ready'; }
