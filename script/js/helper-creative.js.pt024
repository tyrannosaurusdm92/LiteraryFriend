function tensionPlan(opts={}){const beats=Math.max(4,Math.min(20,Number(opts.beats||8))),start=Math.max(0,Math.min(1,Number(opts.start??.25))),peak=Math.max(start,Math.min(1,Number(opts.peak??.88))),release=Math.max(0,Math.min(peak,Number(opts.release??.38))),shape=opts.shape||'wave',out=[];for(let i=0;i<beats;i++){const t=i/Math.max(1,beats-1);let p;if(shape==='steady')p=start+(peak-start)*t;else if(t<.7)p=start+(peak-start)*(t/.7);else p=peak-(peak-release)*((t-.7)/.3);out.push({beat:i+1,pressure:Number(p.toFixed(3)),job:i===0?'establish pressure':i===beats-1?'release enough to expose the next problem':p>peak*.82?'force costly choice':'tighten choices or increase cost'});}return out;}
