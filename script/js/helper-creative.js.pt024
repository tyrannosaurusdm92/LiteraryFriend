(function(global){'use strict';
 const FALLBACK_STYLE=Object.freeze({priorities:['character voice','plot movement','dialogue','sensory specificity','continuity','earned emotion'],avoid:['generic filler','POV drift','repetitive beats','unearned intimacy']});
 const STORY_CONTENT_MODES=Object.freeze({general:{id:'general',label:'General',instruction:'Write plot and character development normally.'},romance:{id:'romance',label:'Romance',instruction:'Romance, affection, kissing, flirting, and relationship development may stay on-page.'},fade_to_black:{id:'fade_to_black',label:'Fade to black',instruction:'If a romantic scene would become sexual, end the on-page scene with [Fade to black.] and resume later without sexual detail.'}});
