/* Writer Tools — optional UI transition for fade-to-black choices. */
(function(global){'use strict';
 const VERSION='1.0.0'; const TARGET='@generate-fade'; let active=false,overlay=null;
 const sleep=ms=>new Promise(r=>global.setTimeout(r,ms));
 function ensureOverlay(){const d=global.document;if(!d?.body)return null;if(overlay?.isConnected)return overlay;overlay=d.getElementById('writerFadeToBlack');if(!overlay){overlay=d.createElement('div');overlay.id='writerFadeToBlack';overlay.className='writer-fade-to-black';overlay.setAttribute('aria-hidden','true');overlay.innerHTML='<div class="writer-fade-to-black__label">Fade to black</div>';d.body.appendChild(overlay);}return overlay;}
 function isFadeChoice(c){return String(c?.target||'').startsWith(TARGET)||String(c?.path_key||'').toLowerCase()==='fade-to-black'||Boolean(c?.fade_to_black);}
 function isResumeChoice(c){return String(c?.path_key||'').toLowerCase()==='resume_story';}
 async function fadeToBlack(){active=true;const n=ensureOverlay();if(n){n.classList.add('is-active');n.setAttribute('aria-hidden','false');await sleep(180);}return true;}
 async function fadeBack(){const n=ensureOverlay();if(n){n.classList.remove('is-active');n.setAttribute('aria-hidden','true');await sleep(180);}active=false;return true;}
 async function beforeChoice({choice}={}){if(!isFadeChoice(choice)&&!isResumeChoice(choice))return false;return fadeToBlack();}
 async function afterChoice({choice}={}){if(!active&&!isFadeChoice(choice)&&!isResumeChoice(choice))return false;return fadeBack();}
 function fadeMetadata(choice,resumeTarget=''){return isFadeChoice(choice)?{visualTransition:'fade_to_black',preserveStoryState:true,resumeTarget:String(choice?.fade_resume_target||resumeTarget||'@generate'),bridgeOwned:false,meaning:'On-page scene ends before sexual detail and resumes later.'}:null;}
 global.WriterToolsFadeController=Object.freeze({VERSION,isFadeChoice,isResumeChoice,beforeChoice,afterChoice,fadeToBlack,fadeBack,fadeMetadata,get active(){return active;}});
})(typeof globalThis!=='undefined'?globalThis:window);

/* ===== END SOURCE: writer-fade-controller.js ===== */

