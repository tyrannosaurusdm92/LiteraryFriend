 function buildStoryContext(series={},parent=null,choice=null,memory={},extra={}){const mode=normalizeMode(extra.contentMode||extra.mode||series.content_mode);return {series:{key:series.key,title:series.title,fandom:series.fandom||'Original',source_context:series.source_context||'',timeline:series.timeline||series.canon_window||''},reader:global.WriterToolsAudience?.get?.()||{},content:{requested_mode:mode,effective_mode:mode,instruction:STORY_CONTENT_MODES[mode]?.instruction||STORY_CONTENT_MODES.romance.instruction},romance_boundary:global.WriterToolsRomanceBoundary?.contractForSeries?.(series)||{},scene_beats:global.WriterToolsSceneBeats?.select?.({series,chapter:parent,choice})||[],parent,choice,memory,extra};}
 function buildStoryPrompt(context={}){return ['STORY WRITER',context?.content?.instruction||'',global.WriterToolsRomanceBoundary?.promptBlock?.(context?.series||{},context)||'',global.StoryTools?.WriterReference?.buildWriterReferencePrompt?.({query:[context?.parent?.title,context?.choice?.description,context?.extra?.direction].filter(Boolean).join(' '),sceneGoal:context?.extra?.direction||''})||'','Carry forward dialogue, facts, callbacks, open plot threads, relationship changes, objects, locations, and consequences.',JSON.stringify(context)].filter(Boolean).join('\n\n');}
