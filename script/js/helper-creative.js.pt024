async function inflate(parts){const b64=parts.join(''),bin=global.atob?global.atob(b64):Buffer.from(b64,'base64').toString('binary'),bytes=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);if(typeof global.DecompressionStream==='function'){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return JSON.parse(await new Response(stream).text());}if(global.pako?.ungzip)return JSON.parse(global.pako.ungzip(bytes,{to:'string'}));throw new Error('Craft research atlas requires DecompressionStream or global pako.');}
