/* ===== RESEARCH EXPANSION PASS II — prose, poetry, haiku, lyrics, composition planning ===== */
(function(global){'use strict';
const base=global.WriterToolsWriting;if(!base)return;
function words(text){return String(text||'').match(/[A-Za-z]+(?:['’-][A-Za-z]+)*/g)||[];}
function sentences(text){return String(text||'').split(/(?<=[.!?])\s+/).map(x=>x.trim()).filter(Boolean);}
function lexicalDiversity(text){const ws=words(text).map(x=>x.toLowerCase()),unique=new Set(ws);return {words:ws.length,unique:unique.size,typeTokenRatio:ws.length?unique.size/ws.length:0};}
