const PROGRESSIONS=Object.freeze({pop:['I','V','vi','IV'],doo_wop:['I','vi','IV','V'],fifty_six_four_one:['vi','IV','I','V'],minor_loop:['i','VI','III','VII'],twelve_bar:['I','I','I','I','IV','IV','I','I','V','IV','I','V']});
function prosodyPlan({intent='build',section='verse',beats=4,stressPattern='1010'}={}){return {intent,section,beats,stressPattern,advice:['Place semantically important stressed syllables on stronger musical accents when possible.','Let melodic contour and harmonic rhythm reinforce the emotional direction rather than fight it accidentally.','Use mismatch deliberately only when the tension it creates serves the song.']};}
