function buildStoryContext(series={},parent=null,choice=null,memory={},extra={}){const c=base.buildStoryContext?.(series,parent,choice,memory,extra)||{};const direction=extra.direction||choice?.generation_hint||choice?.description||'';return {...c,william_voice:global.WriterWilliamVoice?.buildPacket?.({kind:'story',prompt:[series.title,series.premise,direction].filter(Boolean).join(' '),sceneGoal:direction,includeEvidence:true,exampleCount:2})||null,craft_governor:{overExplanation:true,rushedPacing:true,articulation:true,dialogueNaturalism:true}};}
function buildStoryPrompt(context={}){const core=base.buildStoryPrompt?.(context)||'';const voice=global.WriterWilliamVoice?.promptBlock?.({kind:'story',prompt:[context?.series?.title,context?.extra?.direction,context?.choice?.description].filter(Boolean).join(' '),voicePacket:context.william_voice,includeEvidence:true})||'';return [voice,core].filter(Boolean).join('\n\n');}
function poetryPlan(form='free_verse',opts={}){const core=base.poetryPlan?.(form,opts)||{form,...opts};return {...core,williamVoice:global.WriterWilliamVoice?.buildPacket?.({kind:'poetry',form,prompt:opts.subject||opts.topic||'',includeEvidence:true,exampleCount:3})||null,revisionTargets:['compression without emotional distance','intentional line breaks','image coherence','repetition that escalates or transforms','meaning before forced meter/rhyme']};}
function songPlan(opts={}){const core=base.songPlan?.(opts)||{};return {...core,williamVoice:global.WriterWilliamVoice?.buildPacket?.({kind:'lyrics',prompt:opts.subject||opts.topic||opts.intent||'',includeEvidence:true,exampleCount:3})||null,revisionTargets:['one main job per section','simpler hook than verse','breath-sized singable lines','concrete image under abstract feeling','natural rhyme and stress','leave melodic space','change context around repeated hooks']};}
function nonfictionPlan(opts={}){const core=base.nonfictionPlan?.(opts)||{};return {...core,williamVoice:global.WriterWilliamVoice?.buildPacket?.({kind:'nonfiction',prompt:opts.subject||opts.topic||opts.purpose||'',includeEvidence:false})||null,craftTargets:['complete the thought without circular explanation','separate fact, memory, inference, and interpretation','use concrete examples before abstract restatement']};}
global.WriterToolsWriting=Object.freeze({...base,writerStyleDNA,buildStoryContext,buildStoryPrompt,poetryPlan,songPlan,nonfictionPlan});
})(typeof globalThis!=='undefined'?globalThis:window);

