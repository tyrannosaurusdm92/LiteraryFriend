function haikuPlan(opts={}){return {form:'haiku',targetSyllables:opts.targetSyllables||[5,7,5],strict:Boolean(opts.strict),craft:['Anchor in a concrete perception or image.','Use compression and juxtaposition rather than explaining the feeling outright.','Treat 5/7/5 as an optional English-language target unless the project specifically requires it.','Consider a cut/turn between images or perceptions.']};}
function poetryPlan(form='free_verse',opts={}){return {form,sound:['alliteration','assonance','consonance','rhyme/near-rhyme','stress/rhythm'],lineation:['enjambment','end-stop','caesura','stanza break','visual spacing'],image:['concrete sensory image','metaphor','juxtaposition','repetition/refrain'],syntax:['compression','suspension','parallelism','fragment/full-sentence contrast'],constraints:base.FORMS?.[form]||{},...opts};}
function songPlan(opts={}){const sections=opts.sections||['verse','pre-chorus','chorus','verse','chorus','bridge','chorus'],root=opts.root||'C',scaleType=opts.scale||'major',music=base.music||{};return {sections,root,scale:music.scale?.(root,scaleType)||[],progression:music.PROGRESSIONS?.[opts.progression||'pop']||music.PROGRESSIONS?.pop||[],prosody:music.prosodyPlan?.({intent:opts.intent||'build and release',section:'whole song',beats:opts.beats||4,stressPattern:opts.stressPattern||'1010'}),sectionJobs:sections.map((s,i)=>({section:s,index:i+1,job:/chorus|hook|refrain/.test(s)?'state the memorable emotional/semantic center':s==='bridge'?'create contrast or reframe the song':'advance image, situation, or argument toward the hook'})),notes:['Track lyrical stress against musical accent.','Use harmonic/rhythmic contrast to support section function rather than changing chords at random.','A repeated hook should gain context or emotional weight as verses change what it means.']};}
