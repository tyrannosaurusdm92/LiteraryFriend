async function inflate(parts){const b64=parts.join('');const bin=global.atob?global.atob(b64):Buffer.from(b64,'base64').toString('binary');const bytes=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);if(typeof global.DecompressionStream==='function'){const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return JSON.parse(await new Response(stream).text());}if(global.pako?.ungzip)return JSON.parse(global.pako.ungzip(bytes,{to:'string'}));throw new Error('Narrative Craft Atlas requires DecompressionStream or global pako.');}
async function loadAtlasShard(index=0){const key=typeof index==='string'?index:`atlas_${String(Math.max(0,Math.min(META.length-1,Number(index)||0))).padStart(2,'0')}`;if(cache.has(key))return cache.get(key);const p=inflate(PACKS[key]);cache.set(key,p);try{return await p;}catch(e){cache.delete(key);throw e;}}
function hash(s){let h=2166136261;for(const c of String(s||'')){h^=c.charCodeAt(0);h=Math.imul(h,16777619);}return h>>>0;}
async function sampleAtlas(options={},count=8){const seed=[options.form,options.audience,options.purpose,options.seed].filter(Boolean).join('|');const shard=hash(seed||'writer-tools')%META.length;const rows=await loadAtlasShard(shard);let filtered=rows.filter(r=>(!options.form||r.form===options.form)&&(!options.audience||r.audience===options.audience)&&(!options.purpose||r.purpose===options.purpose));if(filtered.length<count)filtered=rows;const start=hash(seed+'#rows')%Math.max(1,filtered.length),out=[];for(let i=0;i<Math.min(count,filtered.length);i++)out.push(filtered[(start+i*97)%filtered.length]);return out;}
function searchLoaded(query='',limit=40){const q=String(query||'').toLowerCase(),out=[];for(const p of cache.values()){if(typeof p?.then==='function')continue;for(const row of p){if(JSON.stringify(row).toLowerCase().includes(q)){out.push(row);if(out.length>=limit)return out;}}}return out;}
function atlasInfo(){return {shards:META,totalCards:META.reduce((n,x)=>n+x.cards,0),loaded:[...cache.keys()]};}
const EXTRA=Object.freeze([
{id:'scene-goal-conflict-stakes',tags:['scene','plot'],level:1,prompt:'Give the scene an immediate goal, an active source of conflict, and stakes that change because of what happens here.'},
{id:'tension-wave',tags:['tension','pacing'],level:1,prompt:'Raise pressure through narrowing choices or increasing cost, then release some pressure so the next rise can register.'},
{id:'causal-chain',tags:['plot','continuity'],level:1,prompt:'Make the next beat happen because of a prior choice, discovery, mistake, or consequence—not because the outline needs it.'},
{id:'dialogue-turn-subtext',tags:['dialogue','subtext'],level:1,prompt:'Give each speaker an immediate want; let the literal topic and emotional topic differ when subtext helps.'},
{id:'cliffhanger-debt',tags:['ending','cliffhanger'],level:1,prompt:'A cliffhanger should defer an answer, not erase causality. Track what question was opened and when it must be paid off.'},
{id:'trope-specificity',tags:['trope','genre'],level:1,prompt:'Use recognizable genre patterns as shorthand, then make causes, consequences, voice, and setting specific to this story.'},
{id:'nonfiction-truth-state',tags:['nonfiction','fact'],level:1,prompt:'For nonfiction, distinguish verified fact, remembered fact, reconstruction, inference, and uncertainty instead of inventing certainty.'},
{id:'poetry-sound-image',tags:['poetry'],level:1,prompt:'In poetry, treat image, sound, rhythm, line break, syntax, and compression as interacting craft choices.'},
{id:'song-prosody',tags:['song','lyrics','music'],level:1,prompt:'Align lyric stress, melodic emphasis, harmonic motion, section function, rhyme, and emotional intent through prosody.'},
{id:'interactive-consequence',tags:['interactive','branching'],level:1,prompt:'Choices should represent different intent or strategy and should alter state, information, cost, relationship, or route when practical.'}
]);
const base=global.WriterToolsSceneBeats||{BEATS:[],select:()=>[],prompt:()=>''};const BEATS=Object.freeze([...(base.BEATS||[]),...EXTRA]);
function select(opts={}){const picked=base.select?base.select(opts):[],text=[opts?.series?.genre,opts?.series?.workType,opts?.choice?.label,opts?.choice?.description].filter(Boolean).join(' ').toLowerCase();const extra=EXTRA.filter(b=>!text||b.tags.some(t=>text.includes(t))||['scene-goal-conflict-stakes','tension-wave','causal-chain'].includes(b.id));return [...picked,...extra].filter((x,i,a)=>a.findIndex(y=>y.id===x.id)===i).slice(0,14);}
function prompt(opts={}){return select(opts).map(b=>`- ${b.prompt}`).join('\n');}
global.WriterToolsSceneBeats=Object.freeze({...base,BEATS,select,prompt,loadAtlasShard,sampleAtlas,searchLoaded,atlasInfo});
})(typeof globalThis!=='undefined'?globalThis:window);

